# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# MongoDB connection string. Required to start the server.
# Atlas SRV:      mongodb+srv://user:pass@cluster.mongodb.net/esn
# Atlas non-SRV:  mongodb://...  (TLS is enabled automatically for mongodb:// URIs)
# Local MongoDB:  mongodb://localhost:27017/esn  together with MONGO_TLS=false
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/esn

# Override the automatic TLS choice: "true" or "false"
# MONGO_TLS=false

# Secret used to sign JWT auth cookies. Required.
JWT_SECRET=change-me

# JWT cookie lifetime in hours (default: 1)
EXPIRATION_TIME=1

# HTTP port (default: 3000)
PORT=3000

# development | production | test
NODE_ENV=development

# Set to "false" to disable auth on API routes (local debugging only)
# REQUIRE_AUTH=true

# Set to "false" to keep the app reachable while a speed test is running
# SPEED_TEST_BLOCK_ENABLED=true
