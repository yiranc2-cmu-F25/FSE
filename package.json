{
  "name": "f25-fse-sa2",
  "version": "1.0.0",
  "description": "This is your team's repo for the ESN Application, the group project conducted in 18652.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "clean-install": "rm -rf node_modules && rm -rf package-lock.json && npm install",
    "lint": "eslint . --ext .js,.mjs",
    "format": "prettier --write .",
    "tidy": "npm run lint && npm run format",
    "dev": "concurrently \"node --watch server.js\" \"npx tailwindcss -i public/css/input.css -o public/css/output.css --watch\"",
    "build": "npm run build:css",
    "build:css": "npx tailwindcss -i public/css/input.css -o public/css/output.css --minify",
    "start": "node server.js",
    "prestart": "npm run build",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --coverage",
    "test:integration:chat-privately": "npm test tests/privateChat.test.js",
    "test:integration:search-information": "npm test tests/searchInformation.test.js",
    "test:integration:update-status": "npm test tests/updateStatus.test.js",
    "test:postAnnouncement": "npm test tests/postAnnouncement.test.js",
    "test:tasks": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --coverage tests/taskController.test.js tests/taskFrontendUtils.test.js",
    "test:integration:tasks": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles tests/taskIntegration.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmu-fse-o1/f25-fse-sa2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cmu-fse-o1/f25-fse-sa2/issues"
  },
  "homepage": "https://github.com/cmu-fse-o1/f25-fse-sa2#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.3.0",
    "mongoose": "^8.18.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^3.4.18",
    "uuid": "^13.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.38.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "express-list-endpoints": "^7.1.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "superagent": "^10.2.3",
    "supertest": "^7.1.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
