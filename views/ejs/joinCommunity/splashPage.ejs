<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Splash Page</title>
    <%- include('../partials/head') %>
  </head>
  <body class="relative min-h-screen bg-white">
    <div
      class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
    >
      <img
        src="./images/photos/bg-photos/pass-first-aid.png"
        alt="Background"
        class="absolute top-[25%] h-1/3 w-full object-cover"
      />
      <div class="absolute inset-0 bg-[#e66c4380]"></div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-white/50 to-transparent"
      ></div>
      <div class="absolute top-[15%] flex flex-col items-center">
        <img
          src="./images/icons/logos/ESN-red-cross.png"
          alt="Logo"
          class="mb-2 w-24"
        />
        <div class="font-poppins text-5xl font-bold text-white">ESN</div>
      </div>
      <p
        class="absolute top-[60%] w-5/6 text-center font-poppins text-base leading-relaxed text-white"
      >
        Your community's network for real-time alerts and help during
        emergencies.
      </p>
      <p
        class="absolute top-[70%] w-5/6 text-center font-poppins text-base leading-relaxed text-white"
      >
        Let's help each other out.
      </p>
      <button
        id="join-community-btn"
        class="absolute top-[80%] h-12 w-5/6 bg-white font-poppins text-lg font-semibold text-theme"
        type="button"
      >
        Join Community
      </button>
    </div>
    <%- include('../partials/searchScreen.ejs') %>
    <script src="/js/joinCommunity/splashPage.js"></script>
  </body>
</html>
