<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Confirm Registration</title>
        <%- include('../partials/head') %>
    </head>
    <body class="min-h-screen bg-white">
        <div
        class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
        >
        <div
            class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1"
        >
            <img
            src="./images/icons/logos/ESN-red-cross.png"
            alt="Logo"
            class="w-20"
            />
            <div
            class="font-poppins font-bold bg-[linear-gradient(0deg,rgba(37,48,77,1)_0%,rgba(86,112,179,1)_100%)] bg-clip-text text-center text-3xl text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]"
            >
            ESN
            </div>
        </div>
        <p
            class="font-poppins font-semibold absolute top-[15%] text-center text-xl leading-normal text-black"
        >
            Just one more step
        </p>
        <p
            class="font-poppins absolute top-[20%] w-5/6 text-center text-sm leading-normal text-gray-500"
        >
            Understand each ESN status before we start
        </p>
        <div class="absolute top-[25%] w-3/4 space-y-6">
            <div class="flex flex-col">
            <p class="font-poppins font-semibold text-base">OK</p>
            <div class="flex items-center gap-2 border-t border-gray-300 py-1">
                <img
                src="./images/icons/status/ok-status-icon.svg"
                alt="ok"
                class="h-6 w-6"
                />
                <p class="font-poppins text-sm text-black">
                I'm safe — no help needed.
                </p>
            </div>
            </div>
            <div class="flex flex-col">
            <p class="font-poppins font-semibold text-base">HELP</p>
            <div class="flex items-center gap-2 border-t border-gray-300 py-1">
                <img
                src="./images/icons/status/help-status-icon.svg"
                alt="help"
                class="h-6 w-6"
                />
                <p class="font-poppins text-sm text-black">
                Need help, not life-threatening.
                </p>
            </div>
            </div>
            <div class="flex flex-col">
            <p class="font-poppins font-semibold text-base">Emergency</p>
            <div class="flex items-center gap-2 border-t border-gray-300 py-1">
                <img
                src="./images/icons/status/emergency-status-icon.svg"
                alt="emergency"
                class="h-6 w-6"
                />
                <p class="font-poppins text-sm text-black">
                Urgent danger — need help now.
                </p>
            </div>
            </div>
            <div class="flex flex-col">
            <p class="font-poppins font-semibold text-base">UNDEFINED</p>
            <div class="flex items-center gap-2 border-t border-gray-300 py-1">
                <img
                src="./images/icons/status/undefined-status-icon.svg"
                alt="undefined"
                class="h-6 w-6"
                />
                <p class="font-poppins text-sm text-black">
                No status set.
                </p>
            </div>
            </div>
        </div>
        <p
            class="font-poppins absolute top-[65%] w-5/6 text-center text-sm leading-normal text-gray-500"
        >
            You can always review more detailed status explanation in app at
            anytime.
        </p>
        <button
            id="btn-understand"
            class="font-poppins font-semibold absolute top-[75%] h-12 w-5/6 bg-theme text-lg text-white"
        >
            I Understand
        </button>
        </div>
        <script src="/js/joinCommunity/acknowledgement.js"></script>
    </body>
</html>
