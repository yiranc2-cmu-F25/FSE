<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Announcements</title>
    <%- include('../partials/head') %>
    <script type="module" src="/js/announcement/getAnnouncement.js"></script>
    <script type="module" src="/js/announcement/postAnnouncement.js"></script>
    <script type="module" src="/js/searchInfo/searchAnnouncement.js"></script>
  </head>
  <!-- PR only Comment -->
  <body
    class="flex max-h-screen min-h-screen flex-col items-center bg-white pb-4"
  >
    <div
      class="relative mx-auto flex w-full max-w-md flex-col items-center pb-6 pt-6"
    >
      <div class="absolute left-5 top-6 justify-center">
        <a
          href="/members"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 bg-white shadow-sm transition hover:bg-gray-100"
        >
          <img
            src="/images/chat-privately/keyboard_arrow_left.svg"
            alt="Back"
            class="w-8"
          />
        </a>
      </div>

      <p
        class="w-full text-center font-poppins text-xl font-semibold leading-normal text-black"
      >
        Announcements
      </p>
    </div>
    <!-- Header -->
    <div class="flex w-full items-center justify-center px-2">
      <img
        src="/images/post-annoucement/view-announcement.svg"
        alt="Image"
        class="h-40"
      />
    </div>
    <div class="flex w-5/6 items-center justify-center gap-2 pt-6">
      <button
        id="create-announcement-btn"
        class="mt-6 flex w-full items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm hover:bg-gray-50"
        type="button"
        aria-expanded="false"
        aria-controls="compose-card"
        data-action="toggle-compose"
      >
        <img
          src="/images/post-annoucement/edit-announcement-pen.png"
          alt=""
          class="h-5 w-5"
        />
        <span class="flex-grow text-left font-poppins text-sm text-gray-500">
          Create a new announcement
        </span>
      </button>
      <form
        id="compose-card"
        class="pointer-events-none hidden max-h-0 w-full scale-95 overflow-hidden rounded-xl border border-gray-200 bg-white p-4 opacity-0 shadow-sm transition-all duration-300 ease-out"
        data-state="collapsed"
      >
        <div class="flex items-start gap-3">
          <img
            src="/images/post-annoucement/edit-announcement-pen.png"
            alt=""
            class="mt-1 h-5 w-5"
          />
          <textarea
            id="announcement-input"
            class="flex-grow resize-none rounded border border-transparent px-2 py-1 font-poppins text-sm text-gray-700 focus:outline-none focus:ring-0"
            rows="2"
            placeholder=" Create a new announcement"
            maxlength="500"
            required
            data-field="content"
          ></textarea>
        </div>

        <div class="mt-3 flex items-center justify-end gap-2">
          <button
            id="send-btn"
            type="submit"
            class="rounded-full bg-rose-400 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-500 disabled:cursor-not-allowed disabled:opacity-40"
            disabled
            data-action="submit"
          >
            Send
          </button>
        </div>
      </form>
    </div>
    <section
      id="announcement-list"
      class="mb-6 mt-6 flex w-5/6 flex-col gap-6 overflow-y-auto overflow-x-hidden scroll-smooth"
      tabindex="0"
    ></section>

    <%- include('../partials/fixedFAB.ejs') %> <%-
    include('../partials/searchScreen.ejs') %>
  </body>
</html>
