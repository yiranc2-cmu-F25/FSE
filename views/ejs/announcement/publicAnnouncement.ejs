<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Announcements</title>
    <%- include('../partials/head') %>
    <script type="module" src="/js/announcement/getAnnouncement.js"></script>
    <script type="module" src="/js/announcement/postAnnouncement.js"></script>
    <script type="module" src="/js/searchInfo/searchAnnouncement.js"></script>
  </head>

  <body class="min-h-screen bg-white">
    <div class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center min-h-0 pt-[220px]">

      <!-- Header -->
      <div class="absolute top-[5%] z-50 flex w-11/12 items-center justify-start gap-1">
        <a
          href="/members"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 bg-white hover:bg-gray-100 shadow-sm transition"
        >
          <img
            src="/images/chat-privately/keyboard_arrow_left.svg"
            alt="Back"
            class="w-8"
          />
        </a>
      </div>

      <p class="font-poppins font-semibold absolute top-[5%] z-10 w-full text-center text-xl leading-normal text-black">
        Announcements
      </p>

      <div class="absolute top-[11%] z-10 flex w-full items-center justify-center px-2">
        <img
          src="/images/post-annoucement/view-announcement.svg"
          alt="Image"
          class="h-40"
        />
      </div>

      <div class="w-full px-2 mt-2 flex flex-col gap-4 min-h-0 flex-1">

        <!-- Create new announcement -->
        <div>
          <button
            id="create-announcement-btn"
            class="mt-6 flex w-full items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm hover:bg-gray-50"
            type="button"
            aria-expanded="false"
            aria-controls="compose-card"
            data-action="toggle-compose"
          >
            <img
              src="/images/post-annoucement/edit-announcement-pen.png"
              alt=""
              class="h-5 w-5"
            />
            <span class="font-poppins flex-grow text-sm text-gray-500 text-left">
              Create a new announcement
            </span>
          </button>
        </div>

        <form
          id="compose-card"
          class="w-full rounded-xl border border-gray-200 bg-white p-4 shadow-sm
                 overflow-hidden transition-all duration-300 ease-out
                 max-h-0 opacity-0 scale-95 pointer-events-none"
          data-state="collapsed"
        >
          <div class="flex items-start gap-3">
            <img
              src="/images/post-annoucement/edit-announcement-pen.png"
              alt=""
              class="mt-1 h-5 w-5"
            />
            <textarea
              id="announcement-input"
              class="font-poppins flex-grow resize-none rounded border border-transparent px-2 py-1 text-sm text-gray-700 focus:outline-none focus:ring-0"
              rows="2"
              placeholder=" Create a new announcement"
              maxlength="500"
              required
              data-field="content"
            ></textarea>
          </div>

          <div class="mt-3 flex items-center justify-end gap-2">
            <button
              id="send-btn"
              type="submit"
              class="rounded-full px-4 py-2 text-sm font-semibold text-white bg-rose-400 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-rose-500 transition"
              disabled
              data-action="submit"
            >
              Send
            </button>
          </div>
        </form>

        <section
          id="announcement-list"
          class="flex-1 min-h-0 flex w-full flex-col gap-6 overflow-y-auto pr-1 scroll-smooth"
          tabindex="0"
        >
          <article class="flex gap-4">
            <!-- left: time-->
            <div class="flex flex-col items-start pt-1 min-w-[64px]">
              <span class="font-poppins text-sm font-medium text-gray-500">Today</span>
              <span class="font-poppins mt-1 text-sm font-medium text-gray-500">03:00</span>
            </div>

            <!-- line -->
            <div class="h-auto w-px bg-gray-200"></div>

            <!-- content -->
            <div class="flex-grow">
              <div class="mb-1 flex items-center gap-2">
                <span class="font-poppins font-bold text-black">yiran123456</span>
                <span class="font-poppins rounded-md bg-gray-400 px-2 py-0.5 text-xs font-semibold text-white">
                  OK
                </span>
              </div>
              <p class="font-poppins text-sm leading-relaxed text-gray-500">
                Welcome to ESN! Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              </p>
            </div>
          </article>
        </section>
      </div>
      <%- include('../partials/relativeFAB.ejs') %>
    </div>
    <%- include('../partials/searchScreen.ejs') %>
  </body>
</html>


