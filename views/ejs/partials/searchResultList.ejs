<% const filteredMessages = [ { sender: "sender1", sendTime: "2026/10/20",
senderStatus: "OK", msgContent: "Content of message sent by sender1",
senderOnline: true}, { sender:"sender2", sendTime: "2026/10/21", senderStatus:
"EMERGENCY", msgContent: "Content ofmessage sent by sender2", senderOnline:
true},{ sender:"sender2", sendTime: "2026/10/21", senderStatus: "EMERGENCY",
msgContent: "Content ofmessage sent by sender2", senderOnline: true},{
sender:"sender3", sendTime: "2026/10/21", senderStatus: "UNDEFINED", msgContent:
"Content ofmessage sent by sender3", senderOnline: false},{ sender:"sender4",
sendTime: "2026/10/21", senderStatus: "UNDEFINED", msgContent:
"Contentofmessagge", senderOnline: false}, { sender:"sender5", sendTime:
"2026/10/21", senderStatus: "UNDEFINED", msgContent: "Content ofmessage ",
senderOnline: false},{ sender:"sender6", sendTime: "2026/10/21", senderStatus:
"UNDEFINED", msgContent: "Content ofmessage sent by sender6", senderOnline:
false},{ sender:"sender7", sendTime: "2026/10/21", senderStatus: "HELP",
msgContent: "Content ofmessage sent by sender7", senderOnline: true},{
sender:"sender8", sendTime: "2026/10/21", senderStatus: "UNDEFINED", msgContent:
"Content ofmessage sent by sender8", senderOnline: false},{ sender:"sender9",
sendTime: "2026/10/21", senderStatus: "OK", msgContent: "Content ofmessage se",
senderOnline: true},]; %> <% const searchMembers = true; %>

<section class="max-h-5/6 m-2 h-5/6 w-full overflow-auto">
  <!-- Insert online members list spliter and  offline members list spliter-->
  <div>
    <% if (searchMembers === true) { %>
    <%-include('../partials/search-member-list-status/online-member.ejs') %>
    <% } %>
  <ul>
    <% filteredMessages.forEach(message => { %>
    <li class="mb-2 rounded-md bg-white p-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold capitalize text-[#9c9c9c]"
            ><%= message.sender %></span
          >

          <% if (message.senderStatus === "OK") { %> <%-
          include('../partials/status-search-tag/OK-tag.ejs') %> <% } %> <% if
          (message.senderStatus === "HELP") { %> <%-
          include('../partials/status-search-tag/HELP-tag.ejs') %> <% } %> <% if
          (message.senderStatus === "EMERGENCY") { %> <%-
          include('../partials/status-search-tag/EMERGENCY-tag.ejs') %> <% } %>
          <% if (message.senderStatus === "UNDEFINED") { %> <%-
          include('../partials/status-search-tag/UNDEFINED-tag.ejs') %> <% } %>
        </div>
        <span class="font-semibold text-[#bebebe]">
          <span class="text-xs"><%= message.sendTime %></span>
        </span>
      </div>
      <!-- Use If statement to display message content. No message content for status search-->
      <span class="text-[#bebebe]">
        <p class="mt-1 text-sm"><%= message.msgContent %></p>
      </span>
    </li>
    <% }); %>
  </ul>
</section>
