

<section class="m-2 flex h-full min-h-0 w-full flex-1 flex-col overflow-hidden items-center">
  <!-- Reusable templates populated by client-side scripts -->
  <template id="no-input-template">
    <li class="rounded-md bg-white p-2">
      <span class="text-sm font-semibold capitalize text-[#9c9c9c] sender-name">Please enter your keywords to search :)</span>
    </li>
  </template>
  <template id="no-result-template">
    <li class="rounded-md bg-white p-2">
      <span class="text-sm font-semibold capitalize text-[#9c9c9c] sender-name">No Matching Results Found :(</span>
    </li>
  </template>
  <template id="message-ok-template">
    <%- include('../partials/status-search-tag/OK-tag.ejs') %>
  </template>
  <template id="message-help-template">
    <%- include('../partials/status-search-tag/HELP-tag.ejs') %>
  </template>
  <template id="message-emergency-template">
    <%- include('../partials/status-search-tag/EMERGENCY-tag.ejs') %>
  </template>
  <template id="message-undefined-template">
    <%- include('../partials/status-search-tag/UNDEFINED-tag.ejs') %>
  </template>
  <template id="message-item-template">
  <li class="rounded-md bg-slate-50 p-2 shadow-sm hover:bg-slate-100">
    <div class="flex flex-col items-left">
      <div class="flex items-center gap-2 pt-1">
        <span class="text-sm font-semibold capitalize text-[#9c9c9c] sender-name"></span>
        <span class="status-tag">
          <!-- Status tag will be inserted here based on sender status -->
        </span>
      </div>
      <span class="font-semibold text-[#bebebe]">
        <span class="text-xs send-time"></span>
      </span>
    </div>
    <span class="text-gray-500 font-semibold break-words">
      <p class="mt-1 text-sm message-content"></p>
    </span>
  </li>
</template>
  <div id="search-result-scroll" class="flex-1 overflow-y-auto min-h-0 overscroll-contain w-full px-2 py-3">
    <% if (typeof searchMembers !== 'undefined' && searchMembers === true) { %>
      <%-include('../partials/search-member-list-status/online-member.ejs') %>
      <ul id="online-search-result-list" class="space-y-2 pb-3">
      </ul>
      <%-include('../partials/search-member-list-status/offline-member.ejs') %>
      <ul id="offline-search-result-list" class="space-y-2">
      </ul>
    <% } else { %>
      <%-include('../partials/search-member-list-status/status-change.ejs') %>
      <ul id="search-result-list" class="space-y-2">
      </ul>
    <% } %>
  </div>
</section>
