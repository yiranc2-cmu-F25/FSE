<!-- Voice Call Panel (Collapsible, shown when call is active) -->
<div
  id="voice-call-panel"
  class="absolute left-4 right-4 top-4 z-30 hidden rounded-xl bg-[#D8937F] shadow-lg"
>
  <!-- Collapsed Header (always visible when panel shown) -->
  <div
    id="voice-panel-header"
    class="flex cursor-pointer items-center justify-between rounded-xl px-4 py-3 hover:bg-[#D8937F]/90"
  >
    <div class="flex items-center gap-3 pointer-events-none">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20">
        <img src="/images/help-group/icon-call.svg" alt="Call" class="h-4 w-4" />
      </div>
      <div>
        <p id="voice-panel-title" class="font-poppins text-sm font-semibold text-white">
          Voice call ongoing
        </p>
        <p id="voice-panel-subtitle" class="font-poppins text-xs text-white/80">
          <!-- Participant count or status -->
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 pointer-events-auto">
      <!-- Join button (shown when not in call) -->
      <button
        id="voice-panel-join-btn"
        type="button"
        class="hidden font-poppins rounded-lg bg-white/20 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/30"
      >
        Join
      </button>

      <!-- Toggle collapse button -->
      <button
        id="voice-toggle-btn"
        type="button"
        class="text-white hover:text-gray-200"
      >
        <img id="voice-toggle-icon" src="/images/help-group/icon-down.svg" alt="Expand" class="h-5 w-5 pointer-events-none" />
      </button>
    </div>
  </div>

  <!-- Expanded Content (toggleable) -->
  <div id="voice-panel-content" class="hidden rounded-b-xl border-t border-white/20 px-4 py-3">
    <!-- Connection Status (only when user is in call) -->
    <div
      id="voice-connection-status"
      class="mb-3 hidden rounded-lg bg-white/20 px-3 py-2 text-center font-poppins text-xs font-semibold text-white"
    >
      Connecting...
    </div>

    <!-- Participants List -->
    <div class="mb-3">
      <h4 class="font-poppins mb-2 text-xs font-semibold text-white/90">
        In call:
      </h4>
      <div
        id="voice-participants-list"
        class="max-h-40 space-y-1.5 overflow-y-auto"
      >
        <!-- Participants will be rendered here -->
      </div>
    </div>

    <!-- Controls (only when user is in call) -->
    <div id="voice-controls" class="hidden flex gap-2">
      <button
        id="voice-mute-btn"
        type="button"
        class="font-poppins flex-1 rounded-lg bg-white/20 px-3 py-2 text-sm font-semibold text-white hover:bg-white/30"
      >
        Mute
      </button>
      <button
        id="voice-leave-btn"
        type="button"
        class="font-poppins flex-1 rounded-lg bg-red-500 px-3 py-2 text-sm font-semibold text-white hover:bg-red-600"
      >
        Leave
      </button>
    </div>
  </div>
</div>

<!-- Participant Item Template -->
<template id="voice-participant-template">
  <div
    class="voice-participant flex items-center justify-between rounded-lg bg-white/10 px-2 py-2"
  >
    <div class="flex items-center gap-2">
      <div
        class="voice-participant-avatar flex h-8 w-8 items-center justify-center rounded-full bg-[#D65841] font-poppins text-xs font-semibold text-white"
      ></div>
      <span class="voice-participant-name font-poppins text-sm font-semibold text-white"></span>
    </div>
    <div class="voice-status-indicator h-2 w-2 rounded-full bg-green-400"></div>
  </div>
</template>
