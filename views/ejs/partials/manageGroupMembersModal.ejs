<div id="manage-members-modal" class="fixed inset-0 z-[1500] h-9/10 w-full max-w-md bg-white/30 backdrop-blur-sm mx-auto hidden items-center justify-center">
  <div
    class="min-h-5/6 flex h-4/5 w-11/12 flex-col items-center rounded-md bg-[#D8937F] p-5"
  >
    <!-- Title -->
    <div class="mb-4 flex w-full items-center justify-between">
      <h2 class="font-poppins text-lg font-semibold text-white">Manage Members</h2>
      <button
        id="manage-members-close"
        type="button"
        class="text-white hover:brightness-90"
      >
        <img
          src="/images/search-info/delete-entry-cross.svg"
          alt="Close"
          class="h-6 w-6"
        />
      </button>
    </div>

    <!-- Error Message -->
    <p id="manage-members-error" class="mb-2 w-full text-xs text-yellow-200 hidden"></p>

    <!-- Results List -->
    <div
      id="manage-members-result-page" class="flex h-full min-h-0 w-full flex-1 flex-col gap-1 overflow-hidden rounded-md bg-white p-2"
    >
      <section class="m-2 flex h-full min-h-0 w-full flex-1 flex-col overflow-hidden items-center">
        <div id="manage-members-scroll" class="flex-1 overflow-y-auto min-h-0 overscroll-contain w-full px-2 py-3">
          <ul id="manage-members-list" class="space-y-2">
          </ul>
        </div>
      </section>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 flex w-full gap-2">
      <button
        id="manage-members-cancel"
        type="button"
        class="flex-1 rounded-md bg-gray-500 px-4 py-2 text-white font-semibold hover:brightness-95"
      >
        Cancel
      </button>
      <button
        id="manage-members-remove"
        type="button"
        class="flex-1 rounded-md bg-[#D65841] px-4 py-2 text-white font-semibold hover:brightness-95"
      >
        Remove
      </button>
    </div>
  </div>
</div>

<template id="manage-member-item-template">
  <li class="manage-member-item rounded-md bg-slate-50 p-3 shadow-sm hover:bg-slate-100 cursor-pointer flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="member-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-full">
        <span class="member-initials font-poppins font-semibold text-white"></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="member-name text-sm font-semibold capitalize text-gray-700"></span>
        <span class="member-status-badge"></span>
      </div>
    </div>
    <img
      class="check-icon h-6 w-6"
      src="/images/help-group/icon-uncheck.svg"
      alt="select"
    />
  </li>
</template>

<template id="manage-owner-item-template">
  <li class="manage-owner-item rounded-md bg-slate-50 p-3 shadow-sm cursor-default flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="member-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-full">
        <span class="member-initials font-poppins font-semibold text-white"></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="member-name text-sm font-semibold capitalize text-gray-700"></span>
        <span class="member-status-badge"></span>
        <span class="text-xs text-gray-500">(Owner)</span>
      </div>
    </div>
  </li>
</template>

<!-- Status badge templates (reused) -->
<template id="manage-status-ok-template">
  <%- include('../partials/status-search-tag/OK-tag.ejs') %>
</template>

<template id="manage-status-help-template">
  <%- include('../partials/status-search-tag/HELP-tag.ejs') %>
</template>

<template id="manage-status-emergency-template">
  <%- include('../partials/status-search-tag/EMERGENCY-tag.ejs') %>
</template>

<template id="manage-status-undefined-template">
  <%- include('../partials/status-search-tag/UNDEFINED-tag.ejs') %>
</template>
