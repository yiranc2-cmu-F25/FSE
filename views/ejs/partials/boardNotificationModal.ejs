<!-- Board Notification Modal -->
<div id="boardNotificationModal" class="fixed top-4 left-1/2 z-[3000] hidden" style="transform: translateX(-50%); width: calc(100% - 2rem); max-width: 28rem;">
  <div class="rounded-2xl bg-white p-4 shadow-lg ring-1 ring-stone-200">
    <div class="flex-1">
      <h4 id="notificationTitle" class="text-base font-semibold text-stone-900"></h4>
    </div>
    <div class="mt-4 flex items-center justify-end gap-2">
      <button id="notificationDismissBtn" type="button" class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm text-stone-700 hover:bg-gray-50">Dismiss</button>
      <button id="notificationViewBtn" type="button" class="rounded-lg px-3 py-1.5 text-sm text-white bg-[#C35F49] hover:brightness-95">View Board</button>
    </div>
  </div>
</div>

