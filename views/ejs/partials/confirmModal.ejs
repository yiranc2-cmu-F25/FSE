<div id="confirm-modal" class="fixed inset-0 z-[1500] hidden items-center justify-center bg-black/30 backdrop-blur-sm">
  <div class="w-11/12 max-w-sm rounded-2xl bg-white p-6 shadow-lg">
    <h3 id="confirm-title" class="mb-3 text-lg font-bold text-gray-800"></h3>
    <p id="confirm-message" class="mb-6 text-sm text-gray-600"></p>
    <div class="flex gap-3">
      <button
        id="confirm-cancel"
        type="button"
        class="flex-1 rounded-lg bg-gray-200 px-4 py-2 font-semibold text-gray-700 hover:bg-gray-300"
      >
        Cancel
      </button>
      <button
        id="confirm-ok"
        type="button"
        class="flex-1 rounded-lg bg-[#D65841] px-4 py-2 font-semibold text-white hover:brightness-95"
      >
        Confirm
      </button>
    </div>
  </div>
</div>
