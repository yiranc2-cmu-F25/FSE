<section class="mt-2 flex w-full items-start justify-between">
  <div
    id="items-per-page"
    class="rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
  >
    <!-- <label for="items-per-page"></label> -->
    <% if (searchMode === "set") { %>
      <p>10 results per load</p>
    <% } %>
    <% if (searchMode === "all") { %>
      <p>all results</p>
    <% } %>
  </div>
  <div class="flex gap-1">
    <div
      id="previous-button"
      class="hidden gap-1 rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
    >
      <img
        src="/images/search-info/keyboard_arrow_left.svg"
        alt="Previous-button"
      />

      <p>Previous</p>
    </div>
    <div
      id="next-button"
      class="hidden gap-1 rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
    >
      <p>Next</p>
      <img
        src="/images/search-info/keyboard_arrow_right.svg"
        alt="Next-button"
      />
    </div>
  </div>
</section>
