<section class="mt-2 flex w-full items-start justify-between">
  <div
    id="items-per-page"
    class="rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
  >
    <label for="items-per-page"></label>
    <select id="items-per-page" name="items-per-page">
      <option value="5">5 results</option>
      <option value="10" selected>10 results</option>
      <option value="20">20 results</option>
    </select>
  </div>
  <div class="flex gap-1">
    <div
      id="previous-button"
      class="flex gap-1 rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
    >
      <img
        src="images/search-info/keyboard_arrow_left.svg"
        alt="Previous-button"
      />

      <p>Previous</p>
    </div>
    <div
      id="previous-button"
      class="flex gap-1 rounded-md border-[1px] border-[#9c9c9c] bg-white p-2 text-xs text-[#9C9C9C]"
    >
      <p>Next</p>
      <img
        src="images/search-info/keyboard_arrow_right.svg"
        alt="Next-button"
        class="h-4 w-4 fill-blue-700"
      />
    </div>
  </div>
</section>
