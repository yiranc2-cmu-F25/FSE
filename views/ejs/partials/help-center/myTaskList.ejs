<%
  const meta = typeof taskListMeta === "undefined" ? {} : taskListMeta;
  const openItems = Array.isArray(openTasks) ? openTasks : [];
  const closedItems = Array.isArray(closedTasks) ? closedTasks : [];

  const gradientClasses = function (categoryType) {
    if (categoryType === "temp-repair") return "from-indigo-50 to-indigo-100";
    if (categoryType === "animal-care") return "from-emerald-50 to-emerald-100";
    if (categoryType === "debris") return "from-amber-50 to-amber-100";
    return "from-stone-50 to-stone-100";
  };

  const statusClasses = function (statusLevel) {
    if (statusLevel === "critical") return "bg-rose-100 text-rose-700";
    if (statusLevel === "urgent") return "bg-amber-100 text-amber-700";
    return "bg-stone-100 text-stone-700";
  };

  const renderTaskCard = function (task) { %>
    <article
      class="flex items-center justify-between rounded-3xl bg-gradient-to-r px-4 py-4 shadow-sm <%= gradientClasses(task.categoryType) %>"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/70 shadow-sm"
        >
          <% if (task.icon && task.icon.src) { %>
            <img
              src="<%= task.icon.src %>"
              alt="<%= task.icon.alt || '' %>"
              class="h-6 w-6"
            />
          <% } else { %>
            <span class="text-base font-semibold text-stone-700">
              <%= (task.category || task.title || "").charAt(0) %>
            </span>
          <% } %>
        </div>

        <div class="space-y-1">
          <p class="text-sm font-semibold text-stone-900">
            &lt;<%= task.category || task.title %>&gt;
          </p>
          <% if (task.statusLabel) { %>
            <span
              class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-semibold <%= statusClasses(task.statusLevel) %>"
            >
              <%= task.statusLabel %>
            </span>
          <% } %>
        </div>
      </div>

      <a
        href="<%= task.href || ('/tasks/' + task.id) %>"
        class="ml-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/80 text-stone-500 shadow-sm transition hover:bg-amber-600 hover:text-white"
        aria-label="View task details"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M9.29 6.71a1 1 0 0 0 0 1.42L12.17 11L9.3 13.88a1 1 0 0 0 1.4 1.42l3.99-4a1 1 0 0 0 0-1.4l-4-4a1 1 0 0 0-1.4 0Z"
          />
        </svg>
      </a>
    </article>
<% }; %>

<section class="pb-28" id="my-task-list-section">
  <div
    class="rounded-3xl border border-stone-200 bg-white px-4 py-5 shadow-sm sm:px-6 sm:py-6"
  >
    <!-- Title + controls -->
    <div class="flex items-center justify-between gap-1">
      <h2 class="text-xl font-semibold tracking-tight text-stone-900 pr-4">
        <%= meta.title %>
      </h2>
      <!-- Search -->
      <label class="relative flex-1">
        <span class="sr-only"><%= meta.searchPlaceholder %></span>
        <span
          class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-stone-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M10.5 4a6.5 6.5 0 0 1 5.147 10.5l3.426 3.427a1 1 0 0 1-1.414 1.414l-3.427-3.426A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9a4.5 4.5 0 0 0 0-9Z"
            />
          </svg>
        </span>
        <input
          id="my-task-search-input"
          type="search"
          name="taskSearch"
          placeholder="<%= meta.searchPlaceholder %>"
          class="w-full rounded-2xl border border-stone-200 bg-white py-2.5 pl-9 pr-3 text-sm text-stone-800 shadow-sm outline-none placeholder:text-stone-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-200"
        />
      </label>

      <!-- Filter controls -->
        <!-- Sort direction toggle -->
        <button
          type="button"
          id="my-task-sort-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-stone-200 bg-white text-stone-500 shadow-sm transition hover:border-amber-400 hover:text-amber-700"
          aria-label="Toggle sort direction"
          data-direction="desc"
        >
          <span id="my-task-sort-toggle-icon" class="text-xs font-semibold">
            ↓
          </span>
        </button>

        <!-- Sort key dropdown -->
        <div class="relative w-40 sm:w-48">
          <label class="sr-only"><%= meta.filterLabel %></label>
          <select
            id="my-task-sort-select"
            name="taskFilter"
            class="w-full appearance-none rounded-2xl border border-stone-200 bg-white py-2.5 pl-3 pr-8 text-sm text-stone-800 shadow-sm focus:border-amber-400 focus:ring-2 focus:ring-amber-200"
          >
            <option value="emergency" selected>Emergency level</option>
            <option value="vacancy">Helpers remaining</option>
            <option value="category">Category</option>
            <option value="postedAt">Posted time</option>
            <option value="status">Task status</option>
          </select>
          <span
            class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-stone-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M6.7 9.3a1 1 0 0 1 1.4 0L12 13.17l3.9-3.88a1 1 0 0 1 1.4 1.42l-4.6 4.55a1 1 0 0 1-1.4 0L6.7 10.7a1 1 0 0 1 0-1.4Z"
              />
            </svg>
          </span>
        </div>
      
    </div>


    <!-- OPEN + CLOSED lists -->
    <div class="mt-5 space-y-5">
      <div>
        <p class="mb-3 text-sm font-semibold text-stone-800">
          OPEN Tasks
        </p>
        <div class="space-y-4" id="my-open-task-items">
          <% openItems.forEach(function (task) { %>
            <% renderTaskCard(task); %>
          <% }); %>
        </div>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold text-stone-800">
          CLOSED Tasks
        </p>
        <div class="space-y-4" id="my-closed-task-items">
          <% closedItems.forEach(function (task) { %>
            <% renderTaskCard(task); %>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>
