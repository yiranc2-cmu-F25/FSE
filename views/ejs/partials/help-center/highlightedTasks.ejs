<% const section = typeof highlightsection === "undefined" ? {} :
highlightsection; const tasks = Array.isArray(highlightedtasks) ?
highlightedtasks : []; %>

<section class="mt-10">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold tracking-tight text-stone-900">
      <%= section.title %>
    </h2>

    <% if (section.viewAllHref) { %>
    <a
      href="<%= section.viewAllHref %>"
      class="text-xs font-medium text-amber-700 hover:text-amber-800"
    >
      <%= section.viewAllLabel %>
    </a>
    <% } %>
  </div>
  <% if (tasks.length === 0) { %>
  <p>All tasks are fully joined. Nice work everyone!</p>
  <% } else { %>
  <div class="-mx-6 mt-4 overflow-x-auto pb-3">
    <div class="flex gap-4 px-6">
      <% tasks.forEach(function(task) { %>
      <article
        class="min-w-[260px] max-w-xs flex-1 rounded-3xl bg-gradient-to-br from-stone-50 to-stone-100 p-4 shadow-sm"
      >
        <!-- Top row: icon + title -->
        <div class="flex items-start gap-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cover bg-center"
            style="<% if (task.bgImageUrl) { %>background-image: url('<%= task.bgImageUrl %>');<% } %>"
          >
            <% if (task.icon && task.icon.src) { %>
            <img
              src="<%= task.icon.src %>"
              alt="<%= task.icon.alt || '' %>"
              class="h-6 w-6"
            />
            <% } else { %>
            <!-- textual fallback for icon -->
            <span class="text-lg font-semibold text-white">
              <%= (task.title || "").charAt(0) %>
            </span>
            <% } %>
          </div>

          <div class="space-y-1">
            <p class="text-sm font-semibold leading-snug text-stone-900">
              <%= task.title %>
            </p>
            <% if (task.location) { %>
            <p class="text-xs leading-tight text-stone-500">
              <%= task.location %>
            </p>
            <% } %>
          </div>
        </div>

        <!-- Meta row: joined + urgency -->
        <div class="mt-4 flex items-center justify-between text-[11px]">
          <div class="flex items-center gap-2 text-stone-600">
            <span
              class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-stone-300"
              aria-hidden="true"
            >
              <!-- placeholder circle icon -->
            </span>
            <span>
              <%= task.joinedCount %> / <%= task.capacity %> <%=
              section.joinedLabel %>
            </span>
          </div>

          <% if (task.urgencyLabel) { %>
          <span
            class="<% if (task.urgencyLevel === 'critical') { %> <% } else if (task.urgencyLevel === 'urgent') { %> <% } else { %> <% } %> rounded-full bg-amber-100 bg-rose-100 bg-stone-100 px-3 py-1 text-[10px] font-semibold text-amber-700 text-rose-700 text-stone-700"
          >
            <%= task.urgencyLabel %>
          </span>
          <% } %>
        </div>

        <!-- CTA -->
        <button
          type="button"
          class="mt-4 inline-flex w-full items-center justify-center rounded-2xl bg-stone-900/5 px-4 py-2.5 text-sm font-semibold text-amber-800 shadow-sm transition hover:bg-amber-700 hover:text-white"
        >
          <%= task.ctaLabel %>
        </button>
      </article>
      <% }) %>
    </div>
  </div>
  <% } %>
</section>
