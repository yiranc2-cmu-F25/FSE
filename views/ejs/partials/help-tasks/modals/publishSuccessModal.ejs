<div
  class="task-flow-modal fixed inset-0 z-[60] hidden"
  data-modal="publish-success-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="publish-success-title"
>
  <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm"></div>
  <div class="relative mx-auto flex min-h-full w-full max-w-3xl items-center justify-center px-4">
    <section class="w-full max-w-md rounded-3xl bg-white px-8 py-9 text-center shadow-2xl ring-1 ring-stone-100">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-50 text-emerald-500">
        <span aria-hidden="true" class="text-2xl font-semibold">✔</span>
        <span class="sr-only">Success icon</span>
      </div>
      <p class="mt-5 text-sm font-semibold uppercase tracking-wide text-emerald-500">
        Success
      </p>
      <h2 id="publish-success-title" class="mt-2 text-xl font-semibold text-stone-900">
        You've published the task successfully!
      </h2>
      <div class="mt-8">
        <button
          type="button"
          class="w-full rounded-2xl bg-emerald-500 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-emerald-600"
          data-modal-close
          data-modal-focus
        >
          Great!
        </button>
      </div>
    </section>
  </div>
</div>

