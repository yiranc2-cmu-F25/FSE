<div
  class="task-flow-modal fixed inset-0 z-[60] hidden"
  data-modal="quit-confirm-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quit-confirm-title"
>
  <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm"></div>
  <div class="relative mx-auto flex min-h-full w-full max-w-3xl items-center justify-center px-4">
    <section class="w-full max-w-md rounded-3xl bg-white px-8 py-9 text-center shadow-2xl ring-1 ring-stone-100">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-50 text-rose-500">
        <span aria-hidden="true" class="text-2xl font-semibold">⇦</span>
        <span class="sr-only">Quit icon</span>
      </div>
      <h2 id="quit-confirm-title" class="mt-6 text-xl font-semibold text-stone-900">
        Quit the Task
      </h2>
      <p class="mt-3 text-sm text-stone-600">
        If you quit the task, your contribution logs will be kept and you can view task details at any time.
      </p>
      <p class="mt-5 text-base font-semibold text-stone-800">
        Are you sure to quit?
      </p>
      <div class="mt-8 grid grid-cols-2 gap-3">
        <button
          type="button"
          class="rounded-2xl border border-stone-200 bg-white py-3.5 text-sm font-semibold text-stone-600 shadow-sm hover:bg-stone-50"
          data-modal-close
          data-modal-focus
        >
          Cancel
        </button>
        <button
          type="button"
          class="rounded-2xl bg-rose-500 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-rose-600"
          data-modal-close
          data-modal-next="quit-success-modal"
        >
          Confirm
        </button>
      </div>
    </section>
  </div>
</div>

