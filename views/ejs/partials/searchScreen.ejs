<div id="search-screen" class="fixed inset-0 z-[1500] h-9/10 w-full max-w-md bg-white/30 backdrop-blur-sm mx-auto hidden items-center justify-center">
  <div
    class="min-h-5/6 flex h-4/5 w-11/12 flex-col items-center rounded-md bg-[#D8937F] p-5"
  >
    <%- include('../partials/search-input.ejs') %>
    <div
      id="result-page" class="flex h-full min-h-0 w-full flex-1 flex-col gap-1 overflow-hidden rounded-md bg-white p-2 items-center justify-center"
    >
      <%-include('../partials/searchResultHeader.ejs') %>
      <%-include('../partials/searchResultList.ejs') %>
      <%-include('../partials/searchResultCount.ejs') %>
    </div>
    <!-- If no result, swap to no-result partial -->
    <%-include('../partials/no-result.ejs') %>
  </div>
</div>
