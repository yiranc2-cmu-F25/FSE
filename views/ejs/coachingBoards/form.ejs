<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New Coaching Board</title>
    <%- include('../partials/head') %>
    <% if (typeof boardId !== 'undefined') { %>
    <script>window.__BOARD_ID__ = "<%= boardId %>"; window.__CURRENT_USER_ID__ = "<%= currentUserId %>"; window.__CURRENT_USER__ = "<%= username %>";</script>
    <% } else { %>
    <script>window.__CURRENT_USER__ = "<%= username %>";</script>
    <% } %>
    <script type="module" src="/js/coachingBoards/form.js"></script>
  </head>
  <body class="min-h-screen bg-white">
    <div class="relative mx-auto flex h-screen w-full max-w-md flex-col overflow-hidden">
      <header class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-white z-50 flex items-center border-b-2 border-slate-200 px-4 pb-4 pt-12">
        <div class="w-12">
          <button id="backBtn" type="button" class="inline-flex items-center justify-center rounded-xl border border-gray-200 p-3">
            <img src="/images/chat-privately/keyboard_arrow_left.svg" alt="Back" class="h-6 w-6" />
          </button>
        </div>
        <div class="flex-1">
          <div class="text-center">
            <h1 id="formTitle" class="font-poppins text-lg font-semibold text-black truncate">New Coaching Board</h1>
          </div>
        </div>
        <div class="w-12"></div>
      </header>
      <main class="flex-1 pt-32 px-4 py-4 overflow-y-auto">
        <section class="rounded-2xl bg-white p-4 shadow ring-1 ring-stone-200">
          <form id="boardForm" class="space-y-5">
            <!-- Exit confirmation modal -->
            <div id="exitModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Leave Editor?</h2>
                <p id="exitModalMessage" class="text-stone-500 text-xs mb-6">Are you sure you want to leave? Your draft will be saved.</p>
                <div class="flex gap-3">
                  <button id="exitCancelBtn" type="button" class="flex-1 rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold">Cancel</button>
                  <button id="exitConfirmBtn" type="button" class="flex-1 rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold">Exit</button>
                </div>
              </div>
            </div>
            <div id="duplicateModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Duplicate Title Detected</h2>
                <p class="text-stone-500 text-xs mb-6">A board with this title already exists under this category.</p>
                <div class="flex gap-3">
                  <button id="changeTitleBtn" type="button" class="flex-1 rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold">Change Title</button>
                  <button id="viewExistingBtn" type="button" class="flex-1 rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold">View Existing</button>
                </div>
              </div>
            </div>
            <div id="draftSavedModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Draft Saved!</h2>
                <p class="text-stone-500 text-xs mb-6">Your draft has been successfully saved.</p>
                <button id="draftSavedOkBtn" type="button" class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold">Great!</button>
              </div>
            </div>
            <div id="skillErrorModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Skill Requirement Not Met</h2>
                <p id="skillErrorMessage" class="text-stone-500 text-xs mb-6"></p>
                <button id="skillErrorOkBtn" type="button" class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold">OK</button>
              </div>
            </div>
            <div id="stepErrorModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Step Requirement Not Met</h2>
                <p id="stepErrorMessage" class="text-stone-500 text-xs mb-6"></p>
                <button id="stepErrorOkBtn" type="button" class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold">OK</button>
              </div>
            </div>
            <div id="deleteConfirmModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
              <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
                  <svg class="h-16 w-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </div>
                <h2 class="text-lg font-bold text-stone-800 mb-2">Delete Board?</h2>
                <p class="text-stone-500 text-xs mb-6">Are you sure you want to delete this board? This action cannot be undone.</p>
                <div class="flex gap-3">
                  <button id="deleteCancelBtn" type="button" class="flex-1 rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold">Cancel</button>
                  <button id="deleteConfirmBtn" type="button" class="flex-1 rounded-2xl bg-red-600 shadow hover:bg-red-700 px-6 py-3 text-sm text-white font-semibold">Delete</button>
                </div>
              </div>
            </div>
            <div>
              <div class="flex items-baseline justify-between">
                <h3 class="text-base font-semibold text-stone-900">Title</h3>
                <p id="titleHelp" class="mt-1 text-xs text-gray-500">Less than 50 characters.</p>
              </div>
              <input id="title" name="title" type="text" class="mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-sm focus:outline-none" maxlength="50" required />
              <p id="titleError" class="mt-1 text-xs text-red-600 hidden"></p>
            </div>
              <div class="mt-4">
              <h3 class="text-base font-semibold text-stone-900">Category</h3>
              <div class="mt-2 relative">
                <select id="category" name="category" class="w-full appearance-none rounded-full border border-stone-300 bg-stone-50 px-3 py-2 pr-12 text-xs font-bold uppercase tracking-wide text-stone-700 focus:outline-none" required></select>
                <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 text-stone-500">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
                    <path d="M6 9l6 6 6-6H6z"/>
                  </svg>
                </span>
              </div>
            </div>
            <div>
              <h3 class="text-base font-semibold text-stone-900">Description</h3>
              <textarea id="description" name="description" rows="3" class="mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-sm focus:outline-none" required></textarea>
            </div>
            <div>
              <h3 class="text-base font-semibold text-stone-900">Objective</h3>
              <textarea id="objective" name="objective" rows="3" class="mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-sm focus:outline-none" required></textarea>
            </div>
            <div>
              <h3 class="text-base font-semibold text-stone-900">Steps</h3>
              <div id="stepsContainer" class="mt-2 space-y-2"></div>
              <button id="addStepBtn" type="button" class="mt-2 inline-flex items-center rounded-lg border border-gray-200 text-white px-3 py-1.5 text-sm hover:bg-gray-50" style="background-color:#C35F49">Add Step</button>
            </div>
            <div>
              <div class="flex items-baseline justify-between">
                <h3 class="text-base font-semibold text-stone-900">Related Skills</h3>
                <p class="text-xs text-stone-500">Add at least one skill you have.</p>
              </div>
              <div id="skillsTagList" class="mt-2 flex flex-wrap gap-2"></div>
              <div class="mt-2 relative">
                <select id="skillSelect" class="w-full appearance-none rounded-full border border-stone-300 bg-stone-50 px-3 py-2 pr-12 text-xs font-bold uppercase tracking-wide text-stone-700 focus:outline-none">
                  <option value="">A a skill</option>
                </select>
                <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 text-stone-500">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
                    <path d="M6 9l6 6 6-6H6z"/>
                  </svg>
                </span>
              </div>
            </div>
            <div>
              <h3 class="text-base font-semibold text-stone-900">Tools (optional)</h3>
              <div id="toolsContainer" class="mt-2 space-y-2"></div>
              <button id="addToolBtn" type="button" class="mt-2 inline-flex items-center rounded-lg border border-gray-200 px-3 py-1.5 text-white text-sm hover:bg-gray-50" style="background-color:#C35F49">Add Tool</button>
            </div>
            <div>
              <h3 class="text-base font-semibold text-stone-900">Notes (optional)</h3>
              <textarea id="notes" name="notes" rows="2" class="mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-sm focus:outline-none"></textarea>
            </div>
            <div class="flex items-center gap-3 justify-center">
              <button id="publishBtn" type="submit" class="inline-flex items-center rounded-xl px-4 py-2 text-white shadow hover:brightness-95 focus:outline-none focus:ring-2" style="background-color:#C35F49">Publish</button>
              <button id="saveDraftBtn" type="button" class="inline-flex items-center rounded-xl bg-gray-700 px-4 py-2 text-white shadow hover:bg-gray-600">Save Draft</button>
              <button id="deleteBtn" type="button" class="inline-flex items-center rounded-xl bg-red-600 px-4 py-2 text-white shadow hover:bg-red-700 hidden">Delete</button>
            </div>
          </form>
        </section>
      </main>
    </div>
    <%- include('../partials/boardNotificationModal.ejs') %>
    <script type="module" src="/js/coachingBoards/boardNotifications.js"></script>
  </body>
</html>


