<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Coaching Boards</title>
    <%- include('../partials/head') %>
    <script>window.__CURRENT_USER_ID__ = "<%= currentUserId %>"; window.__CURRENT_USER__ = "<%= username %>";</script>
    <script type="module" src="/js/coachingBoards/list.js"></script>
    <script type="module" src="/js/searchInfo/searchBoards.js"></script>
    <script type="module" src="/js/notify/notify-bootstrap.js"></script>
    <script type="module" src="/js/notify/notify-listener.js"></script>
  </head>
  <body class="bg-stone-50 text-stone-800 coaching-boards">
    <main class="">
      <header
        class="sticky top-0 z-10 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
        aria-label="Coaching Boards header"
      >
        <div class="px-8 sm:px-10">
          <div
            class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 py-8 shadow-sm sm:w-[108vw]"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <button
                  type="button"
                  aria-label="Open menu"
                  class="shrink-0"
                  id="open-profile-modal"
                >
                  <a
                    class="group inline-flex items-center rounded-md border-[1px] border-red-300 p-1 transition duration-150 hover:border-red-600"
                  >
                    <svg
                      width="800px"
                      height="800px"
                      viewBox="0 -0.5 25 25"
                      class="h-9 w-9 fill-red-300 transition duration-150 group-hover:fill-red-600"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M5.5 7.75C5.08579 7.75 4.75 8.08579 4.75 8.5C4.75 8.91421 5.08579 9.25 5.5 9.25V7.75ZM19.5 9.25C19.9142 9.25 20.25 8.91421 20.25 8.5C20.25 8.08579 19.9142 7.75 19.5 7.75V9.25ZM5.5 11.75C5.08579 11.75 4.75 12.0858 4.75 12.5C4.75 12.9142 5.08579 13.25 5.5 13.25V11.75ZM17.5 13.25C17.9142 13.25 18.25 12.9142 18.25 12.5C18.25 12.0858 17.9142 11.75 17.5 11.75V13.25ZM5.5 15.75C5.08579 15.75 4.75 16.0858 4.75 16.5C4.75 16.9142 5.08579 17.25 5.5 17.25V15.75ZM12.5 17.25C12.9142 17.25 13.25 16.9142 13.25 16.5C13.25 16.0858 12.9142 15.75 12.5 15.75V17.25ZM5.5 9.25H19.5V7.75H5.5V9.25ZM5.5 13.25H17.5V11.75H5.5V13.25ZM5.5 17.25H12.5V15.75H5.5V17.25Z"
                      />
                    </svg>
                  </a>
                </button>
                <img
                  src="/images/icons/logos/ESN-red-cross.png"
                  alt="App logo"
                  class="h-7 w-auto"
                />
              </div>
              <div
                class="grid h-12 w-12 place-content-center rounded-full text-base font-bold text-white shadow-md ring-2 ring-white"
                id="header-avatar"
                style="background-color: #3b6a95"
              >
                <span id="header-avatar-initials"></span>
              </div>
            </div>

            <h1
              class="text-3xl font-semibold tracking-tight text-stone-900 mt-8 mb-4"
            >
              Skill Coaching Boards
            </h1>

            <div class="mb-4">
              <a
                href="/boards/new"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-brand-primary px-6 py-4 text-base font-semibold text-white shadow hover:brightness-95 focus:outline-none focus:ring-2 focus:ring-brand-primary sm:w-[80%]"
              >
                Add New Board
              </a>
            </div>

            <div class="flex gap-2">
              <button
                id="filter-all"
                class="filter-btn active flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="all"
              >
                All
              </button>
              <button
                id="filter-my"
                class="filter-btn flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="my"
              >
                My Boards
              </button>
              <button
                id="filter-subscribed"
                class="filter-btn flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="subscribed"
              >
                Subscribed
              </button>
            </div>
          </div>
        </div>
      </header>

      <div id="boardsList" class="p-4 space-y-5 pb-20"></div>
      <%- include('../partials/featureModal.ejs') %>
      <%- include('../partials/fixedFAB.ejs') %>
      <%- include('../partials/searchScreen.ejs') %>
      <%- include('../partials/nav-bar/absNavBar.ejs') %>
    </main>
    <%- include('../partials/subscriptionModal.ejs') %>
    <%- include('../partials/boardNotificationModal.ejs') %>
    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>
    <script type="module" src="/js/coachingBoards/listHeader.js"></script>
    <script type="module" src="/js/nav-bar/nav-bar.js"></script>
    <script type="module" src="/js/coachingBoards/boardNotifications.js"></script>
    <style>
      .coaching-boards .fixed.bottom-4.right-4 { bottom: 7rem; }
      .filter-btn {
        border-color: #d65841;
        background-color: white;
        color: #d65841;
      }
      .filter-btn.active {
        border-color: #d65841;
        background-color: #d65841;
        color: white;
      }
      .filter-btn:hover:not(.active) {
        background-color: #f9fafb;
        border-color: #d65841;
      }
    </style>
  </body>
</html>


