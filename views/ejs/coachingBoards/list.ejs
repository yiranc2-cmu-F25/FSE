<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Coaching Boards</title>
    <%- include('../partials/head') %>
    <script>window.__CURRENT_USER_ID__ = "<%= currentUserId %>"; window.__CURRENT_USER__ = "<%= username %>";</script>
    <script type="module" src="/js/coachingBoards/list.js"></script>
    <script type="module" src="/js/searchInfo/searchBoards.js"></script>
    <script type="module" src="/js/notify/notify-bootstrap.js"></script>
    <script type="module" src="/js/notify/notify-listener.js"></script>
  </head>
  <body class="bg-stone-50 text-stone-800 coaching-boards">
    <main class="">
      <header
        class="sticky top-0 z-10 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
        aria-label="Coaching Boards header"
      >
        <div class="px-8 sm:px-10">
          <div
            class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 py-8 shadow-sm sm:w-[108vw]"
          >
            <%- include('../partials/help-center/headerBar') %>

            <h1
              class="text-3xl font-semibold tracking-tight text-stone-900 mt-8 mb-4"
            >
              Skill Coaching Boards
            </h1>

            <div class="mb-4">
              <a
                href="/boards/new"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-brand-primary px-6 py-4 text-base font-semibold text-white shadow hover:brightness-95 focus:outline-none focus:ring-2 focus:ring-brand-primary sm:w-[80%]"
              >
                Add New Board
              </a>
            </div>

            <div class="flex gap-2">
              <button
                id="filter-all"
                class="filter-btn active flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="all"
              >
                All
              </button>
              <button
                id="filter-my"
                class="filter-btn flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="my"
              >
                My Boards
              </button>
              <button
                id="filter-subscribed"
                class="filter-btn flex-1 rounded-lg border-2 px-4 py-2 text-sm font-semibold transition-colors"
                data-filter="subscribed"
              >
                Subscribed
              </button>
            </div>
          </div>
        </div>
      </header>

      <div id="boardsList" class="p-4 space-y-5 pb-20"></div>
      <%- include('../partials/featureModal.ejs') %>
      <%- include('../partials/fixedFAB.ejs') %>
      <%- include('../partials/searchScreen.ejs') %>
      <%- include('../partials/nav-bar/absNavBar.ejs') %>
    </main>
    <%- include('../partials/subscriptionModal.ejs') %>
    <%- include('../partials/boardNotificationModal.ejs') %>
    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>
    <script type="module" src="/js/coachingBoards/listHeader.js"></script>
    <script type="module" src="/js/nav-bar/nav-bar.js"></script>
    <script type="module" src="/js/coachingBoards/boardNotifications.js"></script>
    <style>
      .coaching-boards .fixed.bottom-4.right-4 { bottom: 7rem; }
      .filter-btn {
        border-color: #d65841;
        background-color: white;
        color: #d65841;
      }
      .filter-btn.active {
        border-color: #d65841;
        background-color: #d65841;
        color: white;
      }
      .filter-btn:hover:not(.active) {
        background-color: #f9fafb;
        border-color: #d65841;
      }
    </style>
  </body>
</html>


