<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Board Details</title>
    <%- include('../partials/head') %>
    <script>window.__BOARD_ID__ = "<%= boardId %>"; window.__CURRENT_USER_ID__ = "<%= currentUserId %>"; window.__CURRENT_USER__ = "<%= username %>";</script>
    <script type="module" src="/js/coachingBoards/detail.js"></script>
    <script type="module" src="/js/notify/notify-bootstrap.js"></script>
    <script type="module" src="/js/notify/notify-listener.js"></script>
  </head>
  <body class="min-h-screen bg-white">
    <div class="relative mx-auto flex h-screen w-full max-w-md flex-col overflow-hidden">
      <header class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-white z-50 flex items-center border-b-2 border-slate-200 px-4 pb-4 pt-12">
        <div class="w-12">
          <a href="/boards" class="inline-flex items-center justify-center rounded-xl border border-gray-200 p-3">
            <img src="/images/chat-privately/keyboard_arrow_left.svg" alt="Back" class="h-6 w-6" />
          </a>
        </div>
        <div class="flex-1">
          <div class="text-center">
            <h1 id="headerTitle" class="font-poppins text-lg font-semibold text-black break-words px-2">Coaching Board</h1>
            <div class="mt-1 flex justify-center">
              <span id="headerCategory" class="inline-block rounded-full bg-stone-100 px-3 py-1 text-xs font-bold uppercase tracking-wide text-stone-700"></span>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-center gap-2">
          <button id="headerShareBtn" class="inline-flex h-10 w-10 items-center justify-center rounded-full hover:bg-stone-100" aria-label="Share">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-stone-700">
              <g fill="none" fill-rule="evenodd">
                <path d="M18 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8c0-1.1.9-2 2-2h5M15 3h6v6M10 14L20.2 3.8"/>
              </g>
            </svg>
          </button>
          <button id="headerSubscribeBtn" class="inline-flex h-10 w-10 items-center justify-center rounded-full" aria-label="Subscribe"></button>
        </div>
      </header>
      <main class="flex-1 pt-40 px-4 py-4 overflow-y-auto pb-24">
        <section class="rounded-2xl bg-white p-4 shadow ring-1 ring-stone-200">
          <div>
            <h3 class="text-base font-semibold text-stone-900">Description</h3>
            <p id="description" class="mt-1 text-sm text-stone-800"></p>
          </div>
          <div class="mt-4">
            <h3 class="text-base font-semibold text-stone-900">Objective</h3>
            <p id="objective" class="mt-1 text-sm text-stone-800"></p>
          </div>
          <div class="mt-4">
            <h3 class="text-base font-semibold text-stone-900">Steps</h3>
            <ol id="steps" class="mt-2 list-decimal pl-6 space-y-1 text-sm text-stone-800"></ol>
          </div>
          <div class="mt-4">
            <h3 class="text-base font-semibold text-stone-900">Related Skills</h3>
            <ul id="skills" class="mt-2 flex flex-wrap gap-2"></ul>
          </div>
          <div class="mt-4">
            <h3 class="text-base font-semibold text-stone-900">Tools</h3>
            <ul id="tools" class="mt-2 flex flex-wrap gap-2"></ul>
          </div>
          <div class="mt-4">
            <h3 class="text-base font-semibold text-stone-900">Notes</h3>
            <p id="notes" class="mt-1 text-sm text-stone-800"></p>
          </div>
          <div class="mt-6">
          <div class="mt-6 flex items-center justify-between border-t pt-3 text-xs text-stone-500">
            <div>Author: <span id="authorName" class="font-semibold text-stone-700"></span></div>
            <div id="meta"></div>
          </div>
        </section>
        <div id="editButtonContainer" class="mt-6 hidden">
          <a id="editButton" href="#" class="flex w-full items-center justify-center rounded-xl bg-[#C35F49] px-4 py-3 text-white shadow hover:brightness-95">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Edit
          </a>
        </div>
        <section class="mt-6 rounded-2xl bg-white p-4 shadow ring-1 ring-stone-200">
          <h3 class="text-base font-semibold text-stone-900">Comments</h3>
          <div id="comments" class="mt-2 space-y-4"></div>
        </section>
      </main>
      <div class="pointer-events-none fixed bottom-0 left-1/2 z-50 w-full -translate-x-1/2 bg-white border-t border-gray-200">
        <div class="mx-auto w-full max-w-md px-4 py-3">
          <form id="commentForm" class="pointer-events-auto">
            <div class="flex gap-2 items-end">
              <div class="flex-1">
                <textarea id="commentText" rows="1" maxlength="300" class="w-full rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-sm focus:outline-none resize-none overflow-hidden" placeholder="Add a comment..." style="min-height: 2.5rem; max-height: 10rem;"></textarea>
                <div class="mt-1 text-xs text-gray-500 text-right">
                  <span id="charCount">0</span>/300 characters
                </div>
              </div>
              <button type="submit" class="rounded-xl bg-[#C35F49] px-3 py-2 text-white shadow self-end">Post</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <%- include('../partials/subscriptionModal.ejs') %>
    <%- include('../partials/boardNotificationModal.ejs') %>
    <!-- Share Modal -->
    <div id="shareModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
      <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
          <svg class="h-16 w-16 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-stone-800 mb-2">Share Board</h2>
        <p class="text-stone-500 text-xs mb-6">Choose how you want to share this board</p>
        <div class="flex flex-col gap-3">
          <button id="shareCopyLinkBtn" type="button" class="w-full rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            Copy Link
          </button>
          <button id="shareSendToUserBtn" type="button" class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-sm text-white font-semibold flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            Send to User
          </button>
        </div>
        <button id="shareModalCloseBtn" type="button" class="mt-4 w-full rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold">Cancel</button>
      </div>
    </div>
    <!-- Send to User Modal -->
    <div id="sendToUserModal" class="fixed inset-0 z-[2000] h-9/10 w-full max-w-md bg-white/30 backdrop-blur-sm mx-auto hidden items-center justify-center" aria-hidden="true">
      <div class="min-h-5/6 flex h-4/5 w-11/12 flex-col items-center rounded-md bg-[#D8937F] p-5 relative">
        <!-- Close Button (Top Right) -->
        <button id="sendToUserCloseBtn" type="button" class="absolute top-4 right-4 inline-flex items-center justify-center" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <!-- Title -->
        <h2 class="text-xl font-bold text-white mb-4 w-full text-center">Share Board</h2>
        <!-- Search Input -->
        <div class="mb-4 flex w-full items-center justify-center gap-1 rounded-md bg-white p-4">
          <img
            src="/images/search-info/search-amplify.svg"
            alt="search-icon"
            class="h-4 w-4"
          />
          <input
            type="text"
            id="userSearchInput"
            placeholder="Search users..."
            class="w-full bg-white focus:outline-none focus:ring-0"
          />
        </div>
        <!-- User List -->
        <div id="result-page" class="flex h-full min-h-0 w-full flex-1 flex-col gap-1 overflow-hidden rounded-md bg-white p-2 items-center justify-center">
          <div id="userList" class="flex-1 overflow-y-auto min-h-0 overscroll-contain w-full px-2 py-3 space-y-2">
            <!-- Users will be rendered here -->
          </div>
        </div>
        <!-- Copy Link Button -->
        <div class="mt-4 w-full">
          <button id="sendToUserCopyLinkBtn" type="button" class="w-full rounded-md bg-white px-4 py-3 text-sm text-stone-700 font-semibold flex items-center justify-center gap-2 hover:bg-stone-50">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            Copy Link
          </button>
        </div>
      </div>
    </div>
    <script type="module" src="/js/coachingBoards/boardNotifications.js"></script>
    <!-- Delete confirmation modal -->
    <div id="deleteConfirmModal" class="fixed top-0 left-0 right-0 bottom-0 z-[2000] hidden items-center justify-center bg-black/40 backdrop-blur-sm" aria-hidden="true">
      <div class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white">
          <svg class="h-16 w-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-stone-800 mb-2">Delete?</h2>
        <p id="deleteConfirmMessage" class="text-stone-500 text-xs mb-6"></p>
        <div class="flex gap-3">
          <button id="deleteCancelBtn" type="button" class="flex-1 rounded-2xl border border-stone-300 bg-white shadow hover:bg-stone-50 px-6 py-3 text-sm text-stone-700 font-semibold">Cancel</button>
          <button id="deleteConfirmBtn" type="button" class="flex-1 rounded-2xl bg-red-600 shadow hover:bg-red-700 px-6 py-3 text-sm text-white font-semibold">Delete</button>
        </div>
      </div>
    </div>
  </body>
  </html>


