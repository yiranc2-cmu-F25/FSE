<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>503 • Service Unavailable</title>
    <!-- Tailwind (Play CDN for simplicity) -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-white text-gray-800">
    <main class="flex min-h-screen items-center justify-center p-20">
      <section class="flex flex-col gap-2 w-full max-w-md text-center">
        <!-- swap your SVG/illustration here -->
        <!-- <div
        class="mx-auto mb-8 flex h-48 w-48 items-center justify-center rounded-xl bg-gray-100"
        > -->
        <h1 class="text-8xl font-semibold tracking-widest text-[#D65841]">503</h1>
        <p class="mt-2 text-xl font-medium">Service Unavailable</p>
          <img src="/images/icons/illustrations/server-maintenance.svg" alt="" class="flex mx-auto h-64 w-64 items-center object-contain mb-5" />
          <span class="sr-only">Illustration</span>
        </div>


        <p class="mt-6 leading-relaxed text-gray-600">
          The page you requested isn’t available right now because the ESN
          system is undergoing maintenance or an administrator performance test.
        </p>

        <p class="mt-4 font-semibold">Please try again later.</p>

        
      </section>
    </main>
  </body>
</html>
