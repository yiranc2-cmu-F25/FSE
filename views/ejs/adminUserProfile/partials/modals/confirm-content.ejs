<template id="tmpl-modal-confirm">
    <div class="flex flex-col items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600">
             <%- include('../icons/exclamation', { classes: 'w-6 h-6' }) %>
        </div>
        
        <div class="space-y-1">
            <h3 class="text-lg font-bold text-gray-900">Administer User Profile</h3>
            <p class="text-sm text-gray-500 px-2">
                You're about to change a user's account information. This user may be logged out.
            </p>
        </div>

        <div class="flex gap-3 w-full">
            <button id="btn-confirm-cancel" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 rounded-xl transition-colors">
                Cancel
            </button>
            <button id="btn-confirm-action" class="flex-1 bg-primary hover:bg-red-600 text-white font-medium py-2.5 rounded-xl shadow-lg shadow-red-200 transition-colors">
                Confirm
            </button>
        </div>
    </div>
</template>