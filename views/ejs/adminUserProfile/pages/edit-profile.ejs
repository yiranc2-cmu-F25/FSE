<%- include('./../partials/userProfileLayoutHeader', {pageTitle: 'Edit User Profile'}) %>
<%- include('./../partials/userProfileHeader') %>

<form action="/admin/users/update" method="POST" class="px-8 py-4 flex flex-col gap-y-6">
    <div class="flex flex-col gap-y-2">
        <div class="flex items-center justify-start gap-x-2">
            <label for="username" class="text-sm font-medium text-gray-900">Username</label>
            <%- include('./../partials/icons/user-id-svgrepo-com', {classes: 'w-4 h-4 text-white'}) %>
        </div>
        <input type="text" name="username" value="<%=user.username%>" class="w-full rounded-sm border-gray-300 border-b-2 focus:outline-none focus:ring-0 focus:border-primary sm:text-sm" placeholder="Enter your username">
    </div>

    
</form>



<%- include('./../partials/userProfileLayoutFooter') %>

