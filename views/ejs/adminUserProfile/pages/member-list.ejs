<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-stone-50 text-stone-800">
    <main>
        <!-- Header -->
        <header class="sticky top-0 z-10 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60">
            <div class="px-8 sm:px-10">
                <div class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 py-8 shadow-sm sm:w-[108vw]">
                    <!-- Top row: menu button, logo, avatar -->
                    <div class="flex items-center justify-between">
                        <!-- Left: three-dot menu + logo -->
                        <div class="flex items-center gap-4">
                            <button
                                type="button"
                                aria-label="Open menu"
                                class="shrink-0"
                                id="open-profile-modal"
                            >
                                <a class="group inline-flex items-center rounded-md border-[1px] border-red-300 p-1 transition duration-150 hover:border-red-600">
                                    <svg
                                        width="800px"
                                        height="800px"
                                        viewBox="0 -0.5 25 25"
                                        class="h-9 w-9 fill-red-300 transition duration-150 group-hover:fill-red-600"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path d="M5.5 7.75C5.08579 7.75 4.75 8.08579 4.75 8.5C4.75 8.91421 5.08579 9.25 5.5 9.25V7.75ZM19.5 9.25C19.9142 9.25 20.25 8.91421 20.25 8.5C20.25 8.08579 19.9142 7.75 19.5 7.75V9.25ZM5.5 11.75C5.08579 11.75 4.75 12.0858 4.75 12.5C4.75 12.9142 5.08579 13.25 5.5 13.25V11.75ZM17.5 13.25C17.9142 13.25 18.25 12.9142 18.25 12.5C18.25 12.0858 17.9142 11.75 17.5 11.75V13.25ZM5.5 15.75C5.08579 15.75 4.75 16.0858 4.75 16.5C4.75 16.9142 5.08579 17.25 5.5 17.25V15.75ZM12.5 17.25C12.9142 17.25 13.25 16.9142 13.25 16.5C13.25 16.0858 12.9142 15.75 12.5 15.75V17.25ZM5.5 9.25H19.5V7.75H5.5V9.25ZM5.5 13.25H17.5V11.75H5.5V13.25ZM5.5 17.25H12.5V15.75H5.5V17.25Z" />
                                    </svg>
                                </a>
                            </button>
                            <img
                                src="/images/icons/logos/ESN-red-cross.png"
                                alt="App logo"
                                class="h-7 w-auto"
                            />
                        </div>

                        <!-- Right: avatar -->
                        <div
                            class="grid h-12 w-12 place-content-center rounded-full text-base font-bold text-white shadow-md ring-2 ring-white"
                            id="header-avatar"
                            style="background-color: #3b6a95"
                        >
                            <span id="header-avatar-initials"></span>
                        </div>
                    </div>

                    <!-- Title section -->
                    <div class="mt-8 flex items-start justify-between gap-6">
                        <div class="flex items-center gap-2">
                            <h1 class="text-2xl font-extrabold leading-tight tracking-tight sm:text-[44px]">
                                Administer User Profile
                            </h1>
                            <%- include('./../partials/tooltip', { 
                                content: "As an administer, you can administer ESN members' profiles." 
                            }) %>
                        </div>
                    </div>
                    <p class="mt-2 text-sm text-stone-500">
                        As an administer, you can administer ESN members' profiles.
                    </p>
                </div>
            </div>
        </header>

        <!-- Members List Section -->
        <section class="sm:px-10 pb-20" id="member-list-section">
            <div class="rounded-3xl border border-stone-200 bg-white px-4 py-5 shadow-sm sm:px-6 sm:py-6">
                <!-- Title + controls -->
                <div class="flex items-center justify-between gap-1 mb-5">
                    <h2 class="text-xl font-semibold tracking-tight text-stone-900 pr-2">
                        Members
                    </h2>
                    
                    <!-- Search -->
                    <label class="relative flex-1">
                        <span class="sr-only">Search Name</span>
                        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-stone-400">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                                <path fill="currentColor" d="M10.5 4a6.5 6.5 0 0 1 5.147 10.5l3.426 3.427a1 1 0 0 1-1.414 1.414l-3.427-3.426A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9a4.5 4.5 0 0 0 0-9Z" />
                            </svg>
                        </span>
                        <input
                            id="member-search-input"
                            type="search"
                            name="memberSearch"
                            placeholder="Search Name"
                            class="w-full rounded-2xl border border-stone-200 bg-white py-2.5 pl-9 pr-3 text-sm text-stone-800 shadow-sm outline-none placeholder:text-stone-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-200"
                        />
                    </label>

                    <!-- Filter icon (placeholder) -->
                    <button
                        type="button"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-stone-200 bg-white text-stone-500 shadow-sm transition hover:border-amber-400 hover:text-amber-700"
                        aria-label="Filter"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
                            <path fill="currentColor" d="M14 12v7.88c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-2.01-2.01a.989.989 0 0 1-.29-.83V12H3.08a.998.998 0 0 1-.76-1.64L10 2.27c.57-.7 1.86-.7 2.43 0l7.25 8.09c.57.7.29 1.64-.48 1.64H14Z" />
                        </svg>
                    </button>

                    <!-- Sort dropdown -->
                    <div class="relative w-40 sm:w-48">
                        <label class="sr-only">Select option</label>
                        <select
                            id="member-sort-select"
                            name="memberFilter"
                            class="w-full appearance-none rounded-2xl border border-stone-200 bg-white py-2.5 pl-3 pr-8 text-sm text-stone-800 shadow-sm focus:border-amber-400 focus:ring-2 focus:ring-amber-200"
                        >
                            <option value="privilege" selected>Privilege Level</option>
                            <option value="status">Account Status</option>
                        </select>
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-stone-400">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                                <path fill="currentColor" d="M6.7 9.3a1 1 0 0 1 1.4 0L12 13.17l3.9-3.88a1 1 0 0 1 1.4 1.42l-4.6 4.55a1 1 0 0 1-1.4 0L6.7 10.7a1 1 0 0 1 0-1.4Z" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Column Headers -->
                <div class="flex items-center gap-4 mb-4 px-2">
                    <button type="button" class="member-sort-header flex-1 text-left px-3 py-2 rounded-xl bg-stone-50 text-sm font-semibold text-stone-700  transition pointer-events-none" data-sort="username">
                        User Name
                    </button>
                    <button type="button" class="member-sort-header flex-1 text-left px-3 py-2 rounded-xl bg-stone-50 text-sm font-semibold text-stone-700  transition pointer-events-none" data-sort="status">
                        Account Status
                    </button>
                    <button type="button" class="member-sort-header flex-1 text-left px-3 py-2 rounded-xl bg-stone-50 text-sm font-semibold text-stone-700  transition pointer-events-none" data-sort="privilege">
                        Privilege
                    </button>
                </div>

                <!-- Member List -->
                <div class="space-y-2" id="member-list-items">
                    <% if (typeof members !== 'undefined' && Array.isArray(members) && members.length > 0) { %>
                        <% members.forEach(function(member) { %>
                            <a href="/admin/users/<%= member.id %>/edit" class="member-item flex items-center gap-4 px-2 py-3 rounded-xl hover:bg-stone-50 transition cursor-pointer" data-member-id="<%= member.id %>">
                                <div class="flex-1 text-sm font-medium text-stone-900">
                                    <%= member.username %>
                                </div>
                                <div class="flex-1">
                                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase <%= member.status === 'Active' ? 'bg-green-100 text-green-600' : 'bg-gray-300 text-gray-600' %>">
                                        <%= member.status %>
                                    </span>
                                </div>
                                <div class="flex-1">
                                    <% 
                                        let privilegeClass = 'bg-stone-100 text-stone-700';
                                        if (member.privilege === 'Administrator') privilegeClass = 'bg-red-100 text-red-600';
                                        else if (member.privilege === 'Coordinator') privilegeClass = 'bg-orange-100 text-orange-600';
                                    %>
                                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase <%= privilegeClass %>">
                                        <%= member.privilege === 'Administrator' ? 'ADMIN' : member.privilege === 'Coordinator' ? 'COORDINATOR' : 'CITIZEN' %>
                                    </span>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <p class="text-center text-stone-500 py-4">No members available</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <!-- Feature Modal -->
    <%- include('../../partials/featureModal') %>
    <%- include('../../partials/nav-bar/absNavBar.ejs') %>

    <!-- Scripts -->
    <script type="module">
        import { initHeaderAvatar } from "/js/utils/initHeaderAvatar.js";
        initHeaderAvatar();
    </script>
    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>
    <script type="module" src="/js/adminUserProfile/memberList.js"></script>
</body>
</html>

