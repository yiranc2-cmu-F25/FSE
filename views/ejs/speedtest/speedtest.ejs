<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>ESN Speed Test</title>
        <%- include('../partials/head') %>
    </head>

    <body class="min-h-screen bg-white">
        <div class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
        >
        <!-- Header -->
        <div class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1">
            <img
                src="/images/icons/logos/ESN-red-cross.png"
                alt="Logo"
                class="w-20"
            />
            <div class="font-poppins font-bold bg-[linear-gradient(0deg,rgba(37,48,77,1)_0%,rgba(86,112,179,1)_100%)] bg-clip-text text-center text-3xl text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]">
                ESN
            </div>
        </div>

        <p class="font-poppins font-semibold absolute top-[15%] text-center text-xl leading-normal text-black">
            ESN Speed Test
        </p>
        <p class="font-poppins absolute top-[20%] text-center text-sm leading-normal text-gray-500">
            As an administrator, you can check how fast the ESN system responds.
            Enter how long the test should run and how often requests should be sent.
            Tap Initiate Speed Test to begin.
        </p>

        <!-- Illustration -->
        <div class="absolute top-[30%] flex w-full items-center justify-center px-2">
            <img
                src="/images/photos/bg-photos/enter-credential.svg"
                alt="vector"
                class="h-44"/>
        </div>

        <!-- Username -->
        <div class="absolute top-[51%] w-5/6 px-1">
            <label class="block text-left text-sm font-medium text-gray-700 mb-1">
                Desired Total Duration
            </label>
            <div class="flex h-12 items-center rounded-full bg-white px-4 shadow-md">
                <input
                    type="number"
                    name="durationSeconds"
                    min="1"
                    step="1"
                    required
                    placeholder="Enter desired total duration in seconds"
                    class="font-poppins w-full border-none text-sm text-gray-700 outline-none"
                />
            </div>
        </div>

        <!-- Password -->
        <div class="absolute top-[63%] w-5/6 px-1">
            <label class="block text-left text-sm font-medium text-gray-700 mb-1">
                Desired Total Duration
            </label>
            <div class="flex h-12 items-center rounded-full bg-white px-4 shadow-md">
                <input
                    type="number"
                    name="durationSeconds"
                    min="1"
                    step="1"
                    required
                    placeholder="Enter desired total duration in seconds"
                    class="font-poppins w-full border-none text-sm text-gray-700 outline-none"
                />
            </div>
        </div>

        <p class="font-poppins absolute top-[75%] text-center text-sm leading-normal text-gray-500">
            *During speed test, all normal operations will be suspended.
        </p>

        <!-- Submit -->
        <button
            id="btn-join"
            class="font-poppins font-semibold absolute top-[78%] h-12 w-5/6 rounded-md bg-theme text-lg text-white"
        >
            INITIATE PERFORMANCE TEST
        </button>
        </div>

    </body>
</html>
