<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ESN Task Center</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-stone-50 text-stone-800">
    <% const __users = (typeof users !== 'undefined' && Array.isArray(users)) ?
    users : []; %> <% const __hero = (typeof hero !== 'undefined') ? hero : {};
    %> <% const __navButtons = __hero.navButtons || {}; %> <% const
    __highlightSection = __hero.highlightedSection || {}; %> <% const
    __highlightedTasks = Array.isArray(highlightedTasks) ? highlightedTasks :
    []; %> <% const __taskListMeta = (typeof taskListMeta !== 'undefined') ?
    taskListMeta : {}; %> <% const __tasks = Array.isArray(tasks) ? tasks : [];
    %>

    <main class="relative">
      <header
        class="sticky top-0 z-10 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
        aria-label="Landing header"
      >
        <!-- padding from screen edges -->
        <div class="px-8 sm:px-10">
          <!-- one oversized white card, centered and cropped by overflow -->
          <div
            class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 pt-6 shadow-sm sm:w-[108vw] sm:px-12 sm:py-8"
          >
            <!-- ROW 1: top controls on the same card -->
            <%- include('../partials/help-center/headerBar') %>

            <!-- ROW 2 & 3: Page title + nav buttons + highlighted tasks -->
            <%- include('../partials/help-center/navButtons', { navButtons:
            __navButtons }) %> <%-
            include('../partials/help-center/highlightedTasks', {
            highlightsection: __highlightSection, highlightedtasks:
            __highlightedTasks }) %>
          </div>
        </div>
      </header>

      <!-- Tasks list section -->
      <section class="">
        <%- include('../partials/help-center/taskList', { taskListMeta:
        __taskListMeta, tasks: __tasks }) %>
      </section>

      <!-- feature modal + bottom nav -->
      <%- include('../partials/featureModal.ejs') %> <%-
      include('../partials/nav-bar/absNavBar.ejs') %>
    </main>
    <script>
      window.__TASKS__ = <%- JSON.stringify(__tasks || []) %>;
      window.__CURRENT_USER_ID__ = <%- JSON.stringify(currentUserId || null) %>;
      window.__CURRENT_USER__ = "<%= username || '' %>";
    </script>
    <script type="module">
      // Initialize header avatar
      import { initHeaderAvatar } from "/js/utils/initHeaderAvatar.js";
      initHeaderAvatar();

      // Maintain websocket connection
      import { getSocket } from "/js/utils/socket.js";
      const socket = getSocket();
      if (socket && !socket.connected) {
        try {
          socket.connect();
          socket.on?.("connect", () => console.log("[ESN Help Center] socket connected", socket.id));
          socket.on?.("connect_error", (e) => console.warn("[ESN Help Center] connect_error", e?.message || e));
        } catch (e) {
          console.error("[ESN Help Center] socket connect() failed", e);
        }
      }
    </script>
    <script type="module" src="/js/helpCenter/taskList.js"></script>

    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>
    <script type="module" src="/js/nav-bar/nav-bar.js"></script>

    <!-- Task Detail Modal-->
    <%- include('../partials/help-center/taskDetailModal', { task, viewer }) %>

    <!-- Task action alerts -->
    <%- include('../partials/help-tasks/modals/joinConfirmModal') %>
    <%- include('../partials/help-tasks/modals/quitConfirmModal') %>
    <%- include('../partials/help-tasks/modals/joinSuccessModal') %>
    <%- include('../partials/help-tasks/modals/quitSuccessModal') %>
    <%- include('../partials/help-tasks/modals/logSuccessModal') %>

    <script>
      window.__TASK_DETAIL__ = <%- JSON.stringify(task || {}) %>;
      window.__TASK_VIEWER__ = <%- JSON.stringify(viewer || {}) %>;
    </script>

    <script type="module" src="/js/ui/modalManager.js"></script>
    <script type="module" src="/js/helpCenter/taskDetailModal.js"></script>
    <script type="module" src="/js/helpCenter/clickTaskCard.js"></script>

  </body>
</html>
