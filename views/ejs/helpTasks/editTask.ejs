<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit a Task</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-stone-50 text-stone-900">
    <main class=" bg-white">

      <!-- Main white card: scrolls internally, sticky header inside -->
      <section
        class="mx-auto flex max-w-2xl flex-col shadow-sm "
      >
        <!-- Sticky header: back arrow + title -->
        <div
          class="sticky top-0 z-10 rounded-t-3xl bg-white px-6 pt-6 pb-4 sm:px-10 sm:pt-7 sm:pb-4 border-b-2 border-stone-50 shadow-md"
        >
          <div class="flex items-center justify-between">
            <!-- Back arrow button -->
            <button
              type="button"
              id="create-task-back-btn"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-stone-200 bg-white text-stone-500 shadow-sm hover:border-amber-400 hover:text-amber-700"
              aria-label="Back to previous page"
            >
              <!-- placeholder arrow icon -->
              <span class="text-lg font-semibold">&larr;</span>
            </button>

            <h1
              class="flex-1 text-center text-2xl font-semibold tracking-tight text-stone-900"
            >
              Edit A Task
            </h1>

            <!-- right side spacer to keep title centered -->
            <span class="h-11 w-11"></span>
          </div>
        </div>

        <!-- Scrollable content -->
        <div
          class="min-h-screen flex-1 space-y-6 overflow-y-auto px-6 pb-8 pt-6 sm:px-10 sm:pb-10 sm:pt-5"
        >
          <!-- Form (action/method are placeholders for later wiring) -->
          <form
            id="create-task-form"
            action="/api/tasks/single/<%= task?.id || task?._id || '' %>"
            method="POST"
            class="space-y-6"
            data-task-id="<%= task?.id || task?._id || '' %>"
          >
            <!-- Task Title -->
            <div class="space-y-2">
              <label
                for="task-title"
                class="flex items-center gap-2 text-sm font-semibold text-stone-900"
              >
                Task Title
                <!-- icon placeholder -->
                <span
                  class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                >
                  📝
                </span>
              </label>
              <input
                id="task-title"
                name="title"
                type="text"
                placeholder="e.g. Clean car crack debris on Road"
                value="<%= task?.title || '' %>"
                class="w-full rounded-none border-b border-stone-200 bg-transparent pb-2 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Task Status -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label
                  class="flex items-center gap-2 text-sm font-semibold text-stone-900"
                >
                  Task Status
                  <span
                    class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                  >
                    ⚠
                  </span>
                </label>
                <!-- Tooltip button -->
                <button
                  type="button"
                  id="task-status-info-btn"
                  class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-stone-100 text-xs text-stone-400 hover:bg-stone-200 relative group"
                  aria-label="Task status info"
                >
                  !
                  <!-- Tooltip -->
                  <span
                    class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden w-64 rounded-lg bg-stone-800 px-3 py-2 text-xs text-white shadow-lg group-hover:block z-50"
                    role="tooltip"
                  >
                    <strong>OPEN:</strong> Task is open to join and add task log.<br />
                    <strong>CLOSED:</strong> Task does not support join and add task log activities, but still visible to all members and owner can edit the task as usual (change fields except for logs and maybe toggle the task status).
                    <span class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-full border-4 border-transparent border-t-stone-800"></span>
                  </span>
                </button>
              </div>
              <div class="flex gap-3">
                <button
                  type="button"
                  id="task-status-open-btn"
                  data-status="open"
                  class="task-status-btn flex-1 rounded-2xl border px-4 py-2.5 text-sm font-semibold <%= task?.isOpen !== false ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-stone-200 bg-stone-50 text-stone-500' %>"
                >
                  OPEN
                </button>
                <button
                  type="button"
                  id="task-status-closed-btn"
                  data-status="closed"
                  class="task-status-btn flex-1 rounded-2xl border px-4 py-2.5 text-sm font-semibold <%= task?.isOpen === false ? 'border-amber-200 bg-amber-50 text-amber-600' : 'border-stone-200 bg-stone-50 text-stone-500' %>"
                >
                  CLOSED
                </button>
              </div>
              <input
                type="hidden"
                name="isOpen"
                id="task-status-input"
                value="<%= task?.isOpen !== false ? 'true' : 'false' %>"
              />
            </div>

            <!-- Due Date -->
            <div class="space-y-2">
              <label
                for="task-due-date"
                class="flex items-center gap-2 text-sm font-semibold text-stone-900"
              >
                Due Date
                <span
                  class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                >
                  📅
                </span>
              </label>
              <input
                id="task-due-date"
                name="dueDate"
                type="date"
                placeholder="Task should be done by ..."
                value="<%= task?.dueDate ? new Date(task.dueDate).toISOString().split('T')[0] : '' %>"
                class="w-full rounded-none border-b border-stone-200 bg-transparent pb-2 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Number of Helpers -->
            <div class="space-y-2">
              <label
                for="task-helpers"
                class="flex items-center gap-2 text-sm font-semibold text-stone-900"
              >
                Number of Helpers
                <span
                  class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                >
                  👥
                </span>
              </label>
              <input
                id="task-helpers"
                name="helpersNeeded"
                type="number"
                min="1"
                placeholder="How many helpers do you need?"
                value="<%= task?.helpers || '' %>"
                class="w-full rounded-none border-b border-stone-200 bg-transparent pb-2 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-0"
              />
              <!-- Error message for helper validation -->
              <p
                id="helpers-error-msg"
                class="hidden text-xs text-rose-600"
              >
                Number of helpers cannot be below the current number of participants (<%= task?.helpersJoined || 0 %>).
              </p>
            </div>

            <!-- Location -->
            <div class="space-y-2">
              <label
                for="task-location"
                class="flex items-center gap-2 text-sm font-semibold text-stone-900"
              >
                Location
                <span
                  class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                >
                  📍
                </span>
              </label>
              <input
                id="task-location"
                name="location"
                type="text"
                placeholder="Enter the task location"
                value="<%= task?.location || '' %>"
                class="w-full rounded-none border-b border-stone-200 bg-transparent pb-2 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Skills Required -->
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-4">
                <div class="space-y-1">
                  <label
                    for="skill-input"
                    class="flex items-center gap-2 text-sm font-semibold text-stone-900"
                  >
                    Skills Required
                    <span
                      class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                    >
                      ✋
                    </span>
                  </label>
                  <p class="text-xs text-stone-400">
                    Add skills one by one. Press Enter or click the tick to add.
                  </p>
                </div>

                <!-- tick button -->
                <button
                  type="button"
                  id="add-skill-btn"
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-stone-200 bg-white text-amber-700 shadow-sm hover:border-amber-400 hover:bg-amber-50"
                  aria-label="Add skill"
                >
                  <!-- placeholder tick icon -->
                  <span class="text-base font-semibold">&check;</span>
                </button>
              </div>

              <input
                id="skill-input"
                type="text"
                autocomplete="off"
                placeholder="Add a skill"
                class="w-full rounded-none border-b border-stone-200 bg-transparent pb-2 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-0"
              />

              <!-- skill tags container -->
              <div
                id="skill-tags-container"
                class="flex flex-wrap gap-2 pt-2"
              >
                <!-- tags rendered by JS -->
              </div>

              <!-- hidden field to submit the list of skills as JSON / CSV later -->
              <input
                type="hidden"
                name="skills"
                id="skill-hidden-input"
                value="[]"
              />
            </div>

            <!-- Task Category -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <label
                  class="flex items-center gap-2 text-sm font-semibold text-stone-900"
                >
                  Task Category
                  <span
                    class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                  >
                    ⬚
                  </span>
                </label>

                <!-- info icon placeholder -->
                <button
                  type="button"
                  class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-stone-100 text-xs text-stone-400"
                  aria-label="Task category info"
                >
                  ?
                </button>
              </div>

              <!-- category buttons: visuals only for now; you can wire them later -->
              <div class="grid grid-cols-2 gap-3">
                <button
                  type="button"
                  id="debris-category-btn"
                  data-category="debris"
                  class="category-chip inline-flex items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py- text-xs font-semibold text-amber-800 shadow-sm"
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-400/80 text-white"
                  >
                    <img src="/images/help-tasks/icons/task_category/debrisRemoval_cleanUp.svg" alt="Debris Removal Icon" class="h-full w-full"/>
                  </span>
                  <span>Debris Removal</span>
                </button>

                <button
                  type="button"
                  id="temp-repair-category-btn"
                  data-category="temp-repair"
                  class="category-chip inline-flex items-center gap-3 rounded-2xl border border-indigo-100 bg-indigo-50 px-4 py-3 text-xs font-medium text-indigo-700 shadow-sm"
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-400/80 text-white"
                  >
                    <img src="/images/help-tasks/icons/task_category/tempRepair.svg" alt="Temporary Repair Icon" class="h-full w-full"/>
                  </span>
                  <span>Temporary Repair</span>
                </button>

                <button
                  type="button"
                  id="animal-care-category-btn"
                  data-category="animal-care"
                  class="category-chip inline-flex items-center gap-3 rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-xs font-medium text-emerald-700 shadow-sm"
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-400/80 text-white"
                  >
                    <img src="/images/help-tasks/icons/task_category/animalCare.svg" alt="Animal Care Icon" class="h-full w-full"/>
                  </span>
                  <span>Animal Care</span>
                </button>

                <button
                  type="button"
                  id="other-category-btn"
                  data-category="other"
                  class="category-chip inline-flex items-center gap-3 rounded-2xl border border-stone-200 bg-stone-100 px-4 py-3 text-xs font-medium text-stone-500 shadow-sm"
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-stone-300 text-white"
                  >
                    <img src="/images/help-tasks/icons/task_category/otherCategory.svg" alt="Other Icon" class="h-full w-full"/>
                  </span>
                  <span>Other</span>
                </button>
              </div>

              <input
                type="hidden"
                name="category"
                id="task-category-input"
              />
            </div>

            <!-- Task Emergency Level -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <label
                  class="flex items-center gap-2 text-sm font-semibold text-stone-900"
                >
                  Task Emergency Level
                  <span
                    class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                  >
                    ⚙
                  </span>
                </label>

                <button
                  type="button"
                  class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-stone-100 text-xs text-stone-400"
                  aria-label="Emergency level info"
                >
                  ?
                </button>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <button
                  type="button"
                  data-emergency="critical"
                  class="emergency-chip rounded-2xl border border-rose-100 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-500"
                >
                  Critical
                </button>
                <button
                  type="button"
                  data-emergency="urgent"
                  class="emergency-chip rounded-2xl border border-amber-100 bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-600"
                >
                  Urgent
                </button>
                <button
                  type="button"
                  data-emergency="standard"
                  class="emergency-chip rounded-2xl border border-stone-100 bg-stone-50 px-4 py-2.5 text-sm font-semibold text-stone-500"
                >
                  Standard
                </button>
                <button
                  type="button"
                  data-emergency="scheduled"
                  class="emergency-chip rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-2.5 text-sm font-semibold text-emerald-600"
                >
                  Scheduled
                </button>
              </div>

              <input
                type="hidden"
                name="emergencyLevel"
                id="task-emergency-input"
              />
            </div>

            <!-- Task Description -->
            <div class="space-y-2">
              <label
                for="task-description"
                class="flex items-center gap-2 text-sm font-semibold text-stone-900"
              >
                Task Description
                <span
                  class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-stone-100 text-[10px] text-stone-400"
                >
                  ☰
                </span>
              </label>
              <textarea
                id="task-description"
                name="description"
                rows="4"
                placeholder="Add description for viewers to better understand the task"
                class="w-full rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3 text-sm text-stone-900 placeholder:text-stone-300 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-100"
              ><%= task?.description || '' %></textarea>
            </div>

            <!-- Buttons -->
            <div class="space-y-3 pt-2">
              <button
                type="submit"
                id="update-task-btn"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-amber-700 px-4 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-amber-800"
              >
                Update Task
              </button>

              
            </div>
          </form>
        </div>
      </section>
    </main>

    <%- include('../partials/help-tasks/modals/editSuccessModal') %>

    <script>
      // Pass task data to JavaScript for pre-population
      window.__EDIT_TASK_DATA__ = <%- JSON.stringify(task || {}) %>;
    </script>
    <script type="module" src="/js/ui/modalManager.js"></script>
    <script type="module" src="/js/helpCenter/createTask.js"></script>
    <script type="module" src="/js/helpCenter/editTask.js"></script>
  </body>
</html>
