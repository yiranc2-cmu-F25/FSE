<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Help Center</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-stone-50 text-stone-800">
    <% const __hero = (typeof hero !== 'undefined') ? hero : {}; %>
    <% const __taskListMeta = (typeof taskListMeta !== 'undefined') ? taskListMeta : {}; %>

    <% const __tasks =
     (typeof tasks !== 'undefined' && Array.isArray(tasks)) ? tasks : []; %>
    <% const __openTasks =
     (typeof openTasks !== 'undefined' && Array.isArray(openTasks)) ? openTasks : []; %>
    <% const __closedTasks =
     (typeof closedTasks !== 'undefined' && Array.isArray(closedTasks)) ? closedTasks : []; %>


    <main class="relative">
      <!-- Top header card -->
      <header
        class="sticky top-0 z-10 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
      >
        <div class="">
          <div
            class="relative px-10 left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white  py-6 shadow-sm sm:w-[108vw]  sm:py-8"
          >
            <%- include('../partials/help-center/headerBar') %>

            <section class="mt-8 space-y-2">
              <h1 class="text-3xl font-semibold tracking-tight text-stone-900">
                <%= __hero.title %>
              </h1>
              <% if (__hero.body) { %>
                <p class="max-w-xl text-sm leading-relaxed text-stone-600">
                  <%= __hero.body %>
                </p>
              <% } %>
            </section>
          </div>
        </div>
      </header>

      <!-- Tasks card -->
      <section class="">
        <%- include('../partials/help-center/myTaskList', {
          taskListMeta: __taskListMeta,
          openTasks: __openTasks,
          closedTasks: __closedTasks
        }) %>
      </section>

      <!-- existing global components -->
      <%- include('../partials/featureModal.ejs') %>
      <%- include('../partials/nav-bar/absNavBar.ejs') %>
    </main>

    <!-- Expose tasks for frontend filtering -->
    <script>
      window.__MY_TASKS__ = <%- JSON.stringify(__tasks || []) %>;
    </script>
    <script type="module" src="/js/helpCenter/myTasks.js"></script>
    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>
    <script type="module" src="/js/nav-bar/nav-bar.js"></script>
  </body>
</html>
