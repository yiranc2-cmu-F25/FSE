<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>ESN Speed Test</title>
        <%- include('../partials/head') %>
    </head>

    <body class="min-h-screen bg-white">
        <div class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center">

        <!-- Main app container -->
        <div class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1">
            <a href="/help-centers/manage">
                <img
                    src="/images/icons/illustrations/icon-left.svg"
                    alt="Back"
                    class="w-10"
                />
            </a>
        </div>
    
        <p class="font-poppins font-semibold absolute top-[5%] text-center text-xl leading-normal text-black">
            Edit My Help Center
        </p>

        <section class="mt-16 flex w-full items-center justify-center px-2 pt-2 pb-2">
        </section>

        <!-- Illustration area (non-scrollable, sits under header) -->
        <section class="flex w-full items-center justify-center px-2 pt-2 pb-2">
            <img
                src="/images/helpCenter/editHelpCenter.svg"
                alt="Image"
                class="h-40"
            />
        </section>

        <!-- Scrollable content area at the bottom -->
        <main class="flex-1 overflow-y-auto px-4 pb-6">
            <!-- Status / message -->
            <div
                id="help-center-message"
                class="min-h-[1.25rem] text-sm text-gray-600 text-center mb-3"
            ></div>

            <!-- Help center cards list (this is what scrolls) -->
            <section
                id="help-center-list"
                class="mb-6 mt-2 flex flex-col gap-6 scroll-smooth"
                tabindex="0"
            ></section>
        </main>

        </div>

        <script type="module" src="/js/helpCenter/editHelpCenter.js"></script>
    </body>
</html>
