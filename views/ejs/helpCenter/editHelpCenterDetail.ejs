<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Help Center</title>
    <%- include('../partials/head') %>
  </head>

  <body class="min-h-screen bg-white">
    <div class="mx-auto flex h-screen w-full max-w-md flex-col bg-white items-center">

      <!-- Header -->
      <div class="mt-4 flex w-11/12 items-center justify-start gap-1">
        <a href="/help-centers/edit">  <!-- or /help-centers depending on your nav -->
          <img
            src="/images/icons/illustrations/icon-left.svg"
            alt="Back"
            class="w-10"
          />
        </a>
        <p class="flex-1 text-center font-poppins text-xl font-semibold text-black">
          Edit Help Center
        </p>
      </div>

      <!-- Illustration (optional) -->
      <div class="mt-4 flex w-full items-center justify-center px-2">
        <img
          src="/images/helpCenter/editHelpCenter.svg"
          alt="Image"
          class="h-40"
        />
      </div>

      <!-- Form-like content -->
      <div class="mt-6 flex w-5/6 flex-col gap-4">

        <input
            id="name"
            type="text"
            name="name"
            placeholder="Name"
            class="flex h-12 w-full items-center rounded-full bg-white pl-4 pr-4 shadow-md"
            value=""
        />

        <select
            id="type"
            name="type"
            class="flex h-12 w-full items-center rounded-full bg-white pl-4 pr-4 shadow-md"
        >
            <option value="">Select Type</option>
            <option value="shelter">Shelter</option>
            <option value="food">Food</option>
            <option value="medical">Medical</option>
            <option value="counseling">Counseling</option>
        </select>

        <input
            id="address-input"
            type="text"
            name="address"
            placeholder="Address"
            class="flex h-12 w-full items-center rounded-full bg-white pl-4 pr-24 shadow-md"
            autocomplete="off"
            value=""
        />

        <textarea
            id="description"
            name="description"
            placeholder="Description"
            class="mt-2 h-32 w-full rounded-3xl bg-white p-4 shadow-md resize-none"
        ></textarea>

        <input type="hidden" id="lon-input" name="coordinates[0]" />
        <input type="hidden" id="lat-input" name="coordinates[1]" />

        <div id="form-message" class="mt-3 min-h-[1.25rem] text-sm text-center"></div>

        <button 
            id="confirm-Btn"
            class="mt-3 flex h-12 w-full items-center justify-center rounded-full bg-theme text-lg font-poppins font-semibold text-white"
        >
            Confirm
        </button>

        <button
            id="delete-Btn"
            class="mt-3 flex h-12 w-full items-center justify-center rounded-full bg-theme text-lg font-poppins font-semibold text-white"
        >
            Delete
        </button>

        <script type="module" src="/js/helpCenter/editHelpCenterDetail.js"></script>

  </body>
</html>
