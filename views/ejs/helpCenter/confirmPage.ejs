<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Manage Help Center</title>
        <%- include('../partials/head') %>
    </head>

    <body class="min-h-screen bg-white">
        <div class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center">

            <!-- Illustration -->
            <div class="absolute top-[12%] flex w-full items-center justify-center px-2">
                <img
                    src="\images\photos\bg-photos\confirm-registration.svg"
                    alt="Image"
                    class="h-120"/>
            </div>

            <p class="absolute top-[66%] font-poppins text-center text-sm leading-normal text-gray-500">
                You Have Successfully <span id="action">Registered</span> A Help Center
            </p>

            <!-- Start Test -->
            <a href="/help-centers"
                class="absolute top-[72%] font-poppins font-semibold h-12 w-5/6 bg-theme text-lg text-white flex items-center justify-center">
                    OKAY!
            </a>

        </div>
        <script type="module" src="/js/helpCenter/confirmPage.js"></script>
    </body>
</html>
