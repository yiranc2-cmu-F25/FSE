<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Help Center Detail</title>
        <%- include('../partials/head') %>
    </head>

    <body class="min-h-screen bg-white">
        <div class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center">

      <!-- Header -->
        <div class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1">
            <a href="/help-centers/view">
                <img
                    src="/images/icons/illustrations/icon-left.svg"
                    alt="Back"
                    class="w-10"
                />
            </a>
        </div>
    
        <p class="font-poppins font-semibold absolute top-[5%] text-center text-xl leading-normal text-black">
            Help Center Detail
        </p>

        <section class="mt-16 flex w-full items-center justify-center px-2 pt-2 pb-2">
        </section>

      <!-- Content -->
      <main class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-4">

        <!-- Static map snapshot -->
        <div class="w-full mb-3">
          <img
            id="detail-map-snapshot"
            class="h-60 w-full rounded-2xl object-cover border border-gray-200 shadow-sm"
            alt="Help center location map"
          />
        </div>

        <!-- Main card -->
        <section class="rounded-2xl bg-white shadow-md border border-gray-200 px-4 py-4">
          <div class="flex gap-4">
            <!-- Type -->
            <div class="flex w-24 flex-col text-left">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">
                Type
              </span>
              <span id="detail-type"
                    class="mt-1 text-sm font-medium text-gray-700 break-words">
                <!-- filled by JS -->
              </span>
            </div>

            <div class="w-px bg-gray-200"></div>

            <!-- Name + address -->
            <div class="flex-1">
              <h2 id="detail-name"
                  class="mb-1 font-poppins text-lg font-semibold text-black break-words">
                <!-- filled by JS -->
              </h2>
              <p id="detail-location"
                 class="text-xs text-gray-500 break-words mb-2">
                <!-- filled by JS -->
              </p>
            </div>
          </div>

          <!-- Description -->
          <div class="mt-3">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide">
              Description
            </h3>
            <p id="detail-description"
               class="mt-1 text-sm text-gray-700 whitespace-pre-wrap break-words">
              <!-- filled by JS -->
            </p>
          </div>

          <!-- Coordinates (optional) -->
          <div class="mt-3">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide">
              Location (Coordinates)
            </h3>
            <p id="detail-coordinates"
               class="mt-1 text-xs text-gray-500">
              <!-- filled by JS -->
            </p>
          </div>
        </section>

      </main>
    </div>
    
    <script>
      window.MAPBOX_TOKEN = "<%= process.env.MAPBOX_TOKEN %>";
    </script>
    <script type="module" src="/js/helpCenter/viewHelpCenterDetail.js"></script>
  </body>
</html>
