<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Member List</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-stone-50 text-stone-800">
    <main class="">
      <header
        class="sticky top-0 z-50 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
        aria-label="Landing header"
      >
        <!-- padding from screen edges -->
        <div class="px-8 sm:px-10">
          <!-- one oversized white card, centered and cropped by overflow -->
          <div
            class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 py-8 shadow-sm sm:w-[108vw]"
          >
            <!-- ROW 1: top controls on the same card -->
            <div class="flex items-center justify-between">
              <!-- Left: burger (no extra styling) + red cross logo -->
              <div class="flex items-center gap-4">
                <button type="button" aria-label="Open menu" class="shrink-0">
                  <a href="/userFunctions">
                    <img
                      src="/images/icons/ui-components/buttons/Burger-default.png"
                      alt=""
                      class="h-9 w-9"
                    />
                  </a>
                </button>
                <img
                  src="/images/icons/logos/ESN-red-cross.png"
                  alt="App logo"
                  class="h-7 w-auto"
                />
              </div>

              <!-- Right: avatar -->
              <% const avatarBg = (currentUser && currentUser.avatarColor) ||
              '#3B6A95'; %>
              <div
                class="grid h-12 w-12 place-content-center rounded-full text-base font-bold text-white shadow-md ring-2 ring-white"
                id="header-avatar"
                style="background-color: <%- avatarBg %>"
              >
                <span id="header-avatar-initials">
                  <%= (currentUser && currentUser.initials) || "JB" %>
                </span>
              </div>
            </div>

            <!-- ROW 2: greeting + status pill -->
            <div class="mt-8 flex items-start justify-between gap-6">
              <h1
                class="text-2xl font-extrabold leading-tight tracking-tight sm:text-[44px]"
              >
                Hi,
                <span class="font-bold" id="header-name">
                  <%= (currentUser && currentUser.username) || "James" %> </span
                >!
              </h1>

              <div
                class="inline-flex shrink-0 items-center rounded-full bg-green-100 px-4 py-1 text-sm font-semibold text-green-700"
                id="header-status-pill"
              >
                <img
                  src="/images/icons/status/ok-status-icon.svg"
                  alt=""
                  class="mr-2 h-4 w-4"
                  id="header-status-icon"
                />
                <span id="header-status-text"
                  ><%= (currentUser && currentUser.status) || "OK" %></span
                >
              </div>
            </div>

            <!-- ROW 3: centered prompt -->
            <p class="mt-4 text-center text-sm text-stone-500">
              Update your latest status and chat with others
            </p>

            <!-- ROW 4: centered CTA -->
            <div class="mt-2 flex justify-center">
              <a
                href="/chat"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-[#C35F49] px-6 py-4 text-base font-semibold text-white shadow hover:brightness-95 focus:outline-none focus:ring-2 focus:ring-[#C35F49] sm:w-[80%]"
              >
                Public Chat Wall
              </a>
            </div>
          </div>
        </div>
        <!-- soft fade at the bottom of sticky header -->
      </header>

      <!-- Online Members -->
      <section
        aria-labelledby="online-members"
        class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
      >
        <div
          id="online-members-title-div"
          class="flex items-center justify-between border-b border-stone-200 px-4 py-3"
        >
          <h3
            id="online-members-title"
            class="flex items-center gap-2 text-sm font-semibold tracking-wide text-stone-700"
          >
            Online Members
            <span class="sr-only">online</span>
          </h3>
          <img
            src="./images/icons/illustrations/Wifi.png"
            alt="online connected icon"
            class="h-5 w-5"
          />
        </div>

        <div id="online-members-list">
          <ul role="list" class="divide-y divide-stone-100">
            <% users.filter(u => u.online).forEach(function(u){ %>
            <li class="px-4 py-3">
              <article class="flex items-start gap-3">
                <!-- avatar with presence -->
                <div class="relative">
                  <div
                    class="grid h-9 w-9 place-content-center rounded-full text-xs font-bold text-white"
                    style="background-color: <%= u.avatarBg %>"
                  >
                    <%= u.initials %>
                  </div>
                  <span
                    class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-green-500 ring-2 ring-white"
                    aria-label="online"
                  ></span>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="name-status-div flex items-center gap-2">
                    <p class="member-name truncate font-medium">
                      <%= u.name %>
                    </p>

                    <% if (u.verified) { %>
                    <span
                      title="Verified"
                      class="grid h-4 w-4 place-content-center rounded-full bg-emerald-100 text-[10px] text-emerald-700"
                      >✓</span
                    >
                    <% } %> <% if (u.status === 'HELP') { %>
                    <span
                      class="rounded bg-yellow-100 px-1.5 py-0.5 text-xs font-medium text-yellow-800"
                      >HELP</span
                    >
                    <% } else if (u.status === 'EMERGENCY') { %>
                    <span
                      class="rounded bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700"
                      >EMERGENCY</span
                    >
                    <% } %>
                  </div>

                  <!-- optional last message if you add it later -->
                  <!-- <p class="last-message mt-0.5 line-clamp-1 text-sm text-stone-600"><%= u.lastMessage %></p> -->

                  <p class="mt-0.5 text-xs text-stone-500">
                    Last seen <%= u.lastSeen %>
                  </p>
                </div>
              </article>
            </li>
            <% }); %>
          </ul>
          <ul role="list" class="divide-y divide-stone-100">
            <% users.filter(u => u.online).forEach(function(u){ %>
            <li class="px-4 py-3">
              <article class="flex items-start gap-3">
                <!-- avatar with presence -->
                <div class="relative">
                  <div
                    class="grid h-9 w-9 place-content-center rounded-full text-xs font-bold text-white"
                    style="background-color: <%= u.avatarBg %>"
                  >
                    <%= u.initials %>
                  </div>
                  <span
                    class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-green-500 ring-2 ring-white"
                    aria-label="online"
                  ></span>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="name-status-div flex items-center gap-2">
                    <p class="member-name truncate font-medium">
                      <%= u.name %>
                    </p>

                    <% if (u.verified) { %>
                    <span
                      title="Verified"
                      class="grid h-4 w-4 place-content-center rounded-full bg-emerald-100 text-[10px] text-emerald-700"
                      >✓</span
                    >
                    <% } %> <% if (u.status === 'HELP') { %>
                    <span
                      class="rounded bg-yellow-100 px-1.5 py-0.5 text-xs font-medium text-yellow-800"
                      >HELP</span
                    >
                    <% } else if (u.status === 'EMERGENCY') { %>
                    <span
                      class="rounded bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700"
                      >EMERGENCY</span
                    >
                    <% } %>
                  </div>

                  <!-- optional last message if you add it later -->
                  <!-- <p class="last-message mt-0.5 line-clamp-1 text-sm text-stone-600"><%= u.lastMessage %></p> -->

                  <p class="mt-0.5 text-xs text-stone-500">
                    Last seen <%= u.lastSeen %>
                  </p>
                </div>
              </article>
            </li>
            <% }); %>
          </ul>
        </div>
      </section>

      <!-- Offline Members -->
      <section
        aria-labelledby="offline-members"
        class="mt-6 rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
      >
        <div
          id="offline-members-title-div"
          class="flex items-center justify-between border-b border-stone-200 px-4 py-3"
        >
          <h3
            id="offline-members-title"
            class="flex items-center gap-2 text-sm font-semibold tracking-wide text-stone-700"
          >
            Offline Members
          </h3>
          <img
            src="./images/icons/illustrations/Wifi-off.png"
            alt="offline connected icon"
            class="h-5 w-5"
          />
        </div>

        <div id="offline-members-list">
          <ul role="list" class="divide-y divide-stone-100">
            <% users.filter(u => !u.online).forEach(function(u){ %>
            <li class="px-4 py-3">
              <article class="flex items-start gap-3 opacity-80">
                <div class="relative">
                  <div
                    class="grid h-9 w-9 place-content-center rounded-full text-xs font-bold text-white"
                    style="background-color: <%= u.avatarBg %>"
                  >
                    <%= u.initials %>
                  </div>
                  <span
                    class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-stone-300 ring-2 ring-white"
                    aria-label="offline"
                  ></span>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="name-status-div flex items-center gap-2">
                    <p class="member-name truncate font-medium">
                      <%= u.name %>
                    </p>
                    <% if (u.verified) { %>
                    <span
                      title="Verified"
                      class="grid h-4 w-4 place-content-center rounded-full bg-emerald-100 text-[10px] text-emerald-700"
                      >✓</span
                    >
                    <% } %>
                  </div>
                  <p class="mt-0.5 text-xs text-stone-500">
                    Last seen <%= u.lastSeen %>
                  </p>
                </div>
              </article>
            </li>
            <% }); %>
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>
