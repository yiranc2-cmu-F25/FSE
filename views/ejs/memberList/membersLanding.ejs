<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Member List</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-stone-50 text-stone-800">
    <% const __users = (typeof users !== 'undefined' && Array.isArray(users)) ?
    users : []; %>

    <main class="">
      <header
        class="sticky top-0 z-50 overflow-x-hidden rounded-2xl bg-stone-50/80 ring-1 ring-stone-200 backdrop-blur supports-[backdrop-filter]:bg-stone-50/60"
        aria-label="Landing header"
      >
        <!-- padding from screen edges -->
        <div class="px-8 sm:px-10">
          <!-- one oversized white card, centered and cropped by overflow -->
          <div
            class="relative left-1/2 w-[110vw] -translate-x-1/2 rounded-3xl border border-stone-200 bg-white px-12 py-8 shadow-sm sm:w-[108vw]"
          >
            <!-- ROW 1: top controls on the same card -->
            <div class="flex items-center justify-between">
              <!-- Left: burger (no extra styling) + red cross logo -->
              <div class="flex items-center gap-4">
                <button
                  type="button"
                  aria-label="Open menu"
                  class="shrink-0"
                  id="open-profile-modal"
                >
                  <a
                    class="group inline-flex items-center rounded-md border-[1px] border-red-300 p-1 transition duration-150 hover:border-red-600"
                  >
                    <svg
                      width="800px"
                      height="800px"
                      viewBox="0 -0.5 25 25"
                      class="h-9 w-9 fill-red-300 transition duration-150 group-hover:fill-red-600"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M5.5 7.75C5.08579 7.75 4.75 8.08579 4.75 8.5C4.75 8.91421 5.08579 9.25 5.5 9.25V7.75ZM19.5 9.25C19.9142 9.25 20.25 8.91421 20.25 8.5C20.25 8.08579 19.9142 7.75 19.5 7.75V9.25ZM5.5 11.75C5.08579 11.75 4.75 12.0858 4.75 12.5C4.75 12.9142 5.08579 13.25 5.5 13.25V11.75ZM17.5 13.25C17.9142 13.25 18.25 12.9142 18.25 12.5C18.25 12.0858 17.9142 11.75 17.5 11.75V13.25ZM5.5 15.75C5.08579 15.75 4.75 16.0858 4.75 16.5C4.75 16.9142 5.08579 17.25 5.5 17.25V15.75ZM12.5 17.25C12.9142 17.25 13.25 16.9142 13.25 16.5C13.25 16.0858 12.9142 15.75 12.5 15.75V17.25ZM5.5 9.25H19.5V7.75H5.5V9.25ZM5.5 13.25H17.5V11.75H5.5V13.25ZM5.5 17.25H12.5V15.75H5.5V17.25Z"
                      />
                    </svg>
                  </a>
                </button>
                <img
                  src="/images/icons/logos/ESN-red-cross.png"
                  alt="App logo"
                  class="h-7 w-auto"
                />
              </div>

              <!-- Right: avatar -->
              <div
                class="grid h-12 w-12 place-content-center rounded-full text-base font-bold text-white shadow-md ring-2 ring-white"
                id="header-avatar"
                style="background-color: #3b6a95"
              >
                <span id="header-avatar-initials"> </span>
              </div>
            </div>

            <!-- ROW 2: greeting + status pill -->
            <div class="mt-8 flex items-start justify-between gap-6">
              <h1
                class="text-2xl font-extrabold leading-tight tracking-tight sm:text-[44px]"
              >
                Hi,
                <span class="font-bold" id="header-name"> </span>!
              </h1>

              <div
                class="inline-flex shrink-0 items-center rounded-full px-4 py-1 text-sm font-semibold"
                id="status-color"
              >
                <img
                  src="/images/icons/status/ok-status-icon.svg"
                  alt=""
                  class="mr-2 h-4 w-4"
                  id="status-icon"
                />
                <span id="header-status-text">OK</span>
              </div>
            </div>

            <!-- ROW 3: centered prompt -->
            <p class="mt-4 text-center text-sm text-stone-500">
              Update your latest status and chat with others
            </p>

            <!-- ROW 4: centered CTA -->
            <div class="mt-2 flex justify-center">
              <a
                href="/chats"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-[#C35F49] px-6 py-4 text-base font-semibold text-white shadow hover:brightness-95 focus:outline-none focus:ring-2 focus:ring-[#C35F49] sm:w-[80%]"
              >
                Public Chat Wall
              </a>
            </div>
          </div>
        </div>
        <!-- soft fade at the bottom of sticky header -->
      </header>

      <!-- Online Members -->
      <section
        aria-labelledby="online-members"
        class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
      >
        <div
          id="online-members-title-div"
          class="flex items-center justify-between border-b border-stone-200 px-4 py-3"
        >
          <h3
            id="online-members-title"
            class="flex items-center gap-2 text-sm font-semibold tracking-wide text-stone-700"
          >
            Online Members
            <span class="sr-only">online</span>
          </h3>
          <img
            src="./images/icons/illustrations/Wifi.png"
            alt="online connected icon"
            class="h-5 w-5"
          />
        </div>

        <div id="online-members-list">
          <ul role="list" class="divide-y divide-stone-100"></ul>
        </div>
      </section>

      <!-- Offline Members -->
      <section
        aria-labelledby="offline-members"
        class="mt-6 rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
      >
        <div
          id="offline-members-title-div"
          class="flex items-center justify-between border-b border-stone-200 px-4 py-3"
        >
          <h3
            id="offline-members-title"
            class="flex items-center gap-2 text-sm font-semibold tracking-wide text-stone-700"
          >
            Offline Members
          </h3>
          <img
            src="./images/icons/illustrations/Wifi-off.png"
            alt="offline connected icon"
            class="h-5 w-5"
          />
        </div>

        <div id="offline-members-list">
          <ul role="list" class="divide-y divide-stone-100"></ul>
        </div>
      </section>
      <%- include('../partials/featureModal.ejs') %>
    </main>
    <script type="module" src="/js/extensionFeatures/featureModal.js"></script>

    <script>
      window.__CURRENT_USER__ = "<%= username %>";
    </script>

    <!-- <script src="/js/extensionFeatures/burger-toggle.js"></script> -->
    <!-- <script src="/socket.io/socket.io.js"></script> -->
    <script type="module" src="/js/joinCommunity/memberList.js"></script>
  </body>
</html>
