<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>User – Change status</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    
    <%- include('../partials/head') %>
    <script>
      window.__CURRENT_USER__ = "<%= username %>";
      console.log("[status] __CURRENT_USER__ =", window.__CURRENT_USER__);
    </script>
    <script type="module" src="/js/userProfile/statusUpdate.js"></script>
    <script type="module" src="/js/notify/notify-bootstrap.js"></script>
    <script type="module" src="/js/notify/notify-listener.js"></script>
  </head>
  <body class="bg-stone-50 text-stone-900">
    <main class="mx-auto px-8 py-6">
      <!-- Top row: back + page title + (spacer for alignment) -->
      <div class="mt-3 flex items-center justify-between">
        <button
          class="grid h-9 w-9 place-content-center rounded-xl bg-white shadow-sm ring-1 ring-stone-200"
          aria-label="Back"
        >
          <a href="/members">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 text-stone-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              />
            </svg>
          </a>
        </button>

        <h1 class="text-2xl font-semibold tracking-wide">Update ESN Status</h1>

        <!-- spacer to balance the back button -->
        <span class="h-10 w-10"></span>
      </div>

      <!-- Avatar -->
      <section class="mt-8 text-center">
        <div class="inline-grid place-items-center">
          <div
            id="avatar"
            class="grid h-32 w-32 place-content-center rounded-full text-4xl font-extrabold text-white shadow-md ring-4 ring-white"
            style="background-color: #3B6A95"
          >
            <span id ="avatar-initials"></span>
          </div>
        </div>
      </section>

      <!-- Form -->
      <form class="mt-10 space-y-8" id="status-form">
        <!-- User name -->
        <div>
          <label class="block text-lg font-semibold">User Name</label>
          <div class="mt-3 rounded-2xl bg-white shadow ring-1 ring-stone-200">
            <input
              type="text"
              name="displayName"
              class="w-full rounded-2xl bg-white px-4 py-4 text-stone-800 placeholder-stone-400 focus:outline-none"
              placeholder="Enter your name"
              disabled
            />
          </div>
        </div>
        <!-- ESN Status card -->
        <div id="esn-status" data-default="UNDEFINED">
          <h2 class="text-lg font-semibold">ESN Status</h2>
          <div
            class="mt-4 rounded-3xl bg-white p-4 text-stone-700 shadow-lg ring-1 ring-stone-200"
          >
            <ul role="list" class="divide-y divide-stone-100">
              <!-- OK -->
              <li
                class="rounded-md transition duration-700 hover:bg-stone-50 hover:bg-gradient-to-r hover:from-[#D6F6DB] hover:to-[#F0F7F1] hover:font-bold hover:tracking-wide hover:text-[#1A7B29] status-tab status-tab-OK "
                data-status="OK"
              >
                <label class="flex items-center gap-4 px-2 py-4">
                  <img
                    src="/images/icons/status/ok-status-icon.svg"
                    alt=""
                    class="h-7 w-7"
                  />
                  <span class="text-lg">OK</span>
                </label>
              </li>
              <!-- HELP -->
              <li
                class="duration-600 rounded-md transition hover:bg-stone-50 hover:bg-gradient-to-r hover:from-[#FBF5D2] hover:to-[#FCFCF9] hover:font-bold hover:tracking-wide hover:text-[#EFD510] status-tab status-tab-HELP "
                data-status="HELP"
              >
                <label class="flex items-center gap-4 px-2 py-4">
                  <img
                    src="/images/icons/status/help-status-icon.svg"
                    alt=""
                    class="h-7 w-7 p-1"
                  />
                  <span class="text-lg">HELP</span>
                </label>
              </li>
              <!-- EMERGENCY -->
              <li
                class="rounded-md transition duration-700 hover:bg-stone-50 hover:bg-gradient-to-r hover:from-[#F7DDD6] hover:to-[#F7F0F2] hover:font-bold hover:tracking-wide hover:text-[#BE3D26] status-tab status-tab-EMERGENCY"
                data-status="EMERGENCY"
              >
                <label class="flex items-center gap-4 px-2 py-4">
                  <img
                    src="/images/icons/status/emergency-status-icon.svg"
                    alt=""
                    class="h-7 w-7 p-0.5"
                  />
                  <span class="text-lg">EMERGENCY</span>
                </label>
              </li>
              <!-- UNDEFINED -->
              <li
                class="rounded-md transition duration-700 hover:bg-stone-50 hover:bg-gradient-to-r hover:from-[#C9C7C8] hover:to-[#F6F6F6] hover:font-bold hover:tracking-wide hover:text-black status-tab status-tab-UNDEFINED"
                data-status="UNDEFINED"
              >
                <label class="flex items-center gap-4 px-2 py-4">
                  <img
                    src="/images/icons/status/undefined-status-icon-black.svg"
                    alt=""
                    class="h-7 w-7 p-0.5"
                  />
                  <span class="text-lg">UNDEFINED</span>
                </label>
              </li>
            </ul>
          </div>
        </div>
        <!-- Save button -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-4 text-center text-lg font-semibold text-white"
          >
            Save Changes
          </button>
        </div>
      </form>
      <div
        id="status-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
        aria-hidden="true"
      >
        <div
          class="rounded-3xl bg-white p-8 shadow-2xl text-center w-80 animate-fade-in"
        >
          <div
            class="mx-auto mb-6 flex h-28 w-28 items-center justify-center rounded-full bg-white"
          >
            <img
              src="/images/icons/statusnotification/status-notification-logo.png"
              alt="ESN shared"
              class="w-24 h-24 object-contain"
            />
          </div>

          <h2 class="text-xl font-bold text-stone-800 mb-2">
            ESN Status Shared!
          </h2>
          <p class="text-stone-500 text-sm mb-6">
            Keep your ESN status fresh so everyone can support each other! 🙌
          </p>

          <button
            id="status-modal-close"
            class="w-full rounded-2xl bg-[#C35F49] shadow hover:brightness-95 px-6 py-3 text-white font-semibold"
          >
            Great!
          </button>
        </div>
      </div>
    </main>
    <%- include('../partials/boardNotificationModal.ejs') %>
    <script type="module" src="/js/coachingBoards/boardNotifications.js"></script>
  </body>
</html>
