<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Personal Emergency Profile</title>
    <%- include('../partials/head') %>
    <script type="module" src="/js/emergencyProfile/personalEmergencyProfile.js"></script>
  </head>
  <body class="bg-stone-50 text-stone-900 min-h-screen">
    <main class="mx-auto px-6 py-6 max-w-2xl">
      <!-- Header: Back button + Title -->
      <div class="flex items-center justify-between mb-6">
        <a
          href="/emergency-profile"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white shadow-sm transition hover:bg-gray-100"
        >
          <img
            src="/images/chat-privately/keyboard_arrow_left.svg"
            alt="Back"
            class="w-6 h-6"
          />
        </a>

        <h1 class="font-poppins text-xl font-semibold text-black">
          Citizen Profile
        </h1>

        <!-- Spacer for alignment -->
        <span class="w-10"></span>
      </div>

      <!-- Form Section -->
      <form class="space-y-6">
        <!-- Form Fields with Checkboxes -->
        <div class="space-y-6">
          <!-- Header for visibility checkboxes -->
          <div class="flex items-center justify-between mb-1 mt-6">
            <div class="flex-1"></div>
            <div class="text-sm font-semibold text-stone-700">
              Show in OK or HELP
            </div>
          </div>

          <!-- Avatar -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-1">
                Photo
              </label>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <div
                    id="profile-avatar"
                    class="grid h-24 w-24 place-content-center rounded-full text-4xl font-extrabold text-white shadow-md ring-4 ring-white cursor-pointer hover:opacity-80 transition-opacity"
                    style="background-color: #3B6A95"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-12 w-12 text-white opacity-80"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                      />
                    </svg>
                  </div>
                  <button
                    type="button"
                    id="upload-photo-btn"
                    class="hidden rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-black border-2 border-black hover:bg-stone-100 transition-colors ml-24"
                  >
                    Upload
                  </button>
                </div>
                <p id="photo-upload-success" class="hidden font-poppins text-xs text-green-600">
                  Photo uploaded successfully!
                </p>
                <p id="photo-upload-error" class="hidden font-poppins text-xs text-red-600">
                </p>
              </div>
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showAvatar"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Blood Type -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Blood Type
              </label>
              <div class="relative">
                <select
                  name="bloodType"
                  class="w-full rounded-xl bg-white px-4 py-2 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 appearance-none disabled:bg-stone-100 disabled:cursor-not-allowed"
                  disabled
                >
                  <option value="">unknown</option>
                  <option value="A+">A+</option>
                  <option value="A-">A-</option>
                  <option value="B+">B+</option>
                  <option value="B-">B-</option>
                  <option value="AB+">AB+</option>
                  <option value="AB-">AB-</option>
                  <option value="O+">O+</option>
                  <option value="O-">O-</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <svg
                    class="w-5 h-5 text-stone-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </div>
              </div>
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showBloodType"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Height -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Height
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="height"
                  placeholder=""
                  class="w-full rounded-xl bg-white px-4 py-2 pr-12 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                  disabled
                />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-stone-500 text-sm pointer-events-none">cm</span>
              </div>
              <p id="height-error" class="font-poppins mb-1 hidden text-xs text-red-600">
                Height must be between 50 and 300 cm
              </p>
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showHeight"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Weight -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Weight
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="weight"
                  placeholder=""
                  class="w-full rounded-xl bg-white px-4 py-2 pr-12 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                  disabled
                />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-stone-500 text-sm pointer-events-none">kg</span>
              </div>
              <p id="weight-error" class="font-poppins mb-1 hidden text-xs text-red-600">
                Weight must be between 10 and 500 kg
              </p>
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showWeight"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Allergies -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Allergies
              </label>
              <input
                type="text"
                name="allergies"
                placeholder=""
                class="w-full rounded-xl bg-white px-4 py-2 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                disabled
              />
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showAllergies"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Current Medications -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Current Medications
              </label>
              <input
                type="text"
                name="medications"
                placeholder=""
                class="w-full rounded-xl bg-white px-4 py-2 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                disabled
              />
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showMedications"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Chronic Conditions -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Chronic Conditions
              </label>
              <input
                type="text"
                name="chronicConditions"
                placeholder=""
                class="w-full rounded-xl bg-white px-4 py-2 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                disabled
              />
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showChronicConditions"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>

          <!-- Emergency Contacts -->
          <div class="flex items-center gap-4">
            <div class="flex-1 max-w-xs">
              <label class="block text-sm font-semibold text-stone-700 mb-2">
                Emergency Contacts
              </label>
              <input
                type="text"
                name="emergencyContacts"
                placeholder=""
                class="w-full rounded-xl bg-white px-4 py-2 text-stone-800 border border-stone-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-stone-300 disabled:bg-stone-100 disabled:cursor-not-allowed"
                disabled
              />
              <p id="emergency-contacts-error" class="font-poppins mb-1 hidden text-xs text-red-600">
                Emergency contacts must be numbers only (e.g., 1234567890, 0987654321)
              </p>
            </div>
            <div class="flex items-center pt-7">
              <input
                type="checkbox"
                name="showEmergencyContacts"
                class="w-5 h-5 rounded-sm border-2 border-stone-300 text-red-600 focus:ring-red-500 focus:ring-2"
                disabled
              />
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4 pt-8 pb-6">
          <button
            type="button"
            id="change-btn"
            class="flex-1 rounded-lg px-6 py-3 text-center text-base font-semibold text-white shadow-md hover:opacity-90 transition-opacity"
            style="background-color: #C35F49"
          >
            Change
          </button>
          <button
            type="button"
            id="discard-btn"
            class="flex-1 rounded-lg px-6 py-3 text-center text-base font-semibold text-white shadow-md hover:opacity-90 transition-opacity"
            style="background-color: #C35F49"
          >
            Delete
          </button>
    </div>
      </form>
    </main>

    <!-- Confirm Delete Modal -->
    <div id="confirm-delete-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true">
      <div class="mx-4 w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
        <!-- Illustration -->
        <div class="mb-6 flex justify-center">
          <div class="grid h-24 w-24 place-content-center rounded-full bg-red-100">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-16 w-16 text-red-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
              />
            </svg>
          </div>
        </div>
        
        <!-- Title -->
        <h2 class="mb-3 text-center text-xl font-bold text-stone-800">
          Delete Emergency Profile?
        </h2>
        
        <!-- Description -->
        <p class="mb-6 text-center text-base text-stone-600">
          Are you sure you want to delete your emergency profile? This action cannot be undone.
        </p>
        
        <!-- Buttons -->
        <div class="flex gap-3">
          <button
            id="confirm-delete-cancel"
            type="button"
            class="flex-1 rounded-lg border-2 border-stone-300 bg-white px-6 py-3 text-center text-base font-semibold text-stone-700 shadow-sm hover:bg-stone-50 transition-colors"
          >
            Cancel
          </button>
          <button
            id="confirm-delete-ok"
            type="button"
            class="flex-1 rounded-lg bg-[#C35F49] px-6 py-3 text-center text-base font-semibold text-white shadow-md hover:opacity-90 transition-opacity"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Success Modal -->
    <div id="success-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true">
      <div class="mx-4 w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
        <!-- Illustration -->
        <div class="mb-6 flex justify-center">
          <div class="grid h-24 w-24 place-content-center rounded-full bg-pink-100">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-16 w-16 text-pink-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              />
            </svg>
          </div>
        </div>
        
        <!-- Title -->
        <h2 id="success-modal-title" class="mb-3 text-center text-xl font-bold text-stone-800">
          Emergency Profile Saved!
        </h2>
        
        <!-- Description -->
        <p id="success-modal-description" class="mb-6 text-center text-base text-stone-600">
          Your emergency profile has been updated successfully.
        </p>
        
        <!-- Button -->
        <button
          id="success-modal-close"
          type="button"
          class="w-full rounded-lg bg-[#C35F49] px-6 py-3 text-center text-base font-semibold text-white shadow-md hover:opacity-90 transition-opacity"
        >
          Great!
        </button>
      </div>
    </div>
  </body>
</html>