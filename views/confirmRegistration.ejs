<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Confirm Registration</title>
        <%- include('partials/head') %>
    </head>

    <body class="min-h-screen bg-white">
        <main class="mx-auto max-w-md px-5 py-6">
        <!-- Header -->
        <header class="mb-6 flex items-center gap-2">
            <img
            src="/images/icons/logos/ESN-red-cross.png"
            alt="ESN Logo"
            class="h-auto w-14"
            />
            <div
            class="font-poppins font-bold bg-[linear-gradient(0deg,rgba(37,48,77,1)_0%,rgba(86,112,179,1)_100%)] bg-clip-text text-3xl text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]"
            >
            ESN
            </div>
        </header>

        <!-- Hero copy -->
        <section class="mb-6">
            <h1
            class="font-poppins font-semibold text-center text-2xl text-black sm:text-3xl"
            >
            Please confirm Account Creation
            </h1>
            <p
            class="font-poppins mt-3 text-center text-sm leading-6 text-gray-600"
            >
            Upon joining ESN community, your ESN status will be shared and visible
            to other connected ESN members. You will also see other members'
            statuses in real time.
            </p>
        </section>

        <!-- Illustration -->
        <section class="mb-6 flex justify-center">
            <img
            src="/images/photos/bg-photos/confirm-registration.svg"
            alt="Confirm registration illustration"
            class="h-52 sm:h-60"
            />
        </section>

        <!-- Form card -->
        <section class="rounded-2xl bg-white p-4 shadow-md">
            <label
            for="username"
            class="font-poppins mb-1 block text-sm text-gray-700"
            >
            Your account name to be created
            </label>
            <div
            id="wrap-username"
            class="mb-4 flex h-12 items-center rounded-full bg-white px-4 shadow"
            >
            <input
                id="username"
                type="text"
                readonly
                class="font-poppins w-full border-none text-sm text-gray-800 outline-none"
                placeholder="Enter Your User Name"
            />
            </div>

            <p class="font-poppins mb-1 text-xs text-gray-500">
            We’re excited to have you! For your security, please
            <span class="font-poppins font-semibold"
                >confirm by re-typing your password</span
            >.
            </p>

            <p
            id="err-password"
            role="alert"
            class="font-poppins mb-1 hidden text-xs text-red-600"
            ></p>

            <div
            id="wrap-password"
            class="mb-4 flex h-12 items-center rounded-full bg-white px-4 shadow"
            >
            <input
                id="password"
                type="password"
                placeholder="Re-enter Password"
                class="font-poppins w-full border-none text-sm text-gray-800 outline-none"
            />
            </div>

            <button
            id="btn-confirm"
            class="font-poppins font-semibold h-12 w-full rounded-xl bg-theme text-lg text-white"
            >
            Confirm Creation
            </button>
        </section>

        <!-- Footer link -->
        <p
            class="font-poppins mt-5 text-center text-sm leading-5 text-gray-500"
        >
            Don't want to create an ESN account?
            <a id="link-home" href="/" class="font-poppins font-semibold text-theme"
            >Home Page</a
            >
        </p>
        </main>

        <!-- Failure modal -->
        <div
        id="fail-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40"
        >
        <div class="mx-4 w-full max-w-sm rounded-lg bg-white p-6 shadow-lg">
            <h3 class="font-poppins font-semibold mb-2 text-lg">Registration failed</h3>
            <p
            id="fail-msg"
            class="font-poppins mb-4 text-sm text-gray-700"
            >
            Registration failed, try again later.
            </p>
            <div class="flex justify-end">
            <button
                id="modal-close"
                class="font-poppins font-semibold rounded-md bg-gray-200 px-4 py-2 text-sm"
            >
                Close
            </button>
            </div>
        </div>
        </div>

        <!-- External script -->
        <script type="module" src="/js/confirmRegistration.js"></script>
    </body>
</html>
