<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap");
      .font-poppins-bold {
        font-family: "Poppins", Helvetica;
        font-weight: 700;
      }
      .font-poppins-semibold {
        font-family: "Poppins", Helvetica;
        font-weight: 600;
      }
      .font-poppins-regular {
        font-family: "Poppins", Helvetica;
        font-weight: 400;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white">
    <div
      class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
    >
      <div
        class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1"
      >
        <img src="image-13.png" alt="Logo" class="w-20" />
        <div
          class="font-poppins-bold bg-[linear-gradient(0deg,rgba(37,48,77,1)_0%,rgba(86,112,179,1)_100%)] bg-clip-text text-center text-3xl text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]"
        >
          ESN
        </div>
      </div>
      <p
        class="font-poppins-semibold absolute top-[15%] text-center text-xl leading-normal text-black"
      >
        Please confirm Account Creation
      </p>
      <p
        class="font-poppins-regular absolute top-[20%] w-3/4 text-center text-sm leading-normal text-gray-500"
      >
        Upon joining ESN community, your ESN status will be shared and visible
        to other connected ESN members. <br />
        You will also see other members' statuses in real time.
      </p>
      <div
        class="absolute top-[35%] flex w-full items-center justify-center px-2"
      >
        <img src="group.svg" alt="vector" class="h-60" />
      </div>
      <p
        class="font-poppins-regular absolute top-[65%] w-5/6 text-sm text-gray-700"
      >
        Your account name to be created
      </p>
      <div
        class="absolute top-[68%] flex h-12 w-5/6 items-center rounded-full bg-white px-4 shadow-md"
      >
        <span class="font-poppins-regular text-sm text-gray-500">
          Enter Your User Name
        </span>
      </div>
      <button
        class="font-poppins-semibold absolute top-[75%] h-12 w-5/6 bg-[#d65841] text-lg text-white"
      >
        Confirm Creation
      </button>
      <p
        class="font-poppins-regular absolute top-[82%] text-center text-sm leading-5 text-gray-500"
      >
        Don't want to create ESN account?
        <a href="#" class="font-poppins-semibold text-[#d65841]">Home Page</a>
      </p>
    </div>
  </body>
</html>
