<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Splash Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap");
      .font-poppins-bold {
        font-family: "Poppins", Helvetica;
        font-weight: 700;
      }
      .font-poppins-semibold {
        font-family: "Poppins", Helvetica;
        font-weight: 600;
      }
      .font-poppins-regular {
        font-family: "Poppins", Helvetica;
        font-weight: 400;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white">
    <div
      class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
    >
      <img
        src="image-16.png"
        alt="Background"
        class="absolute top-[25%] h-1/3 w-full object-cover"
      />
      <div class="absolute inset-0 bg-[#e66c4380]"></div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-white/50 to-transparent"
      ></div>
      <div class="absolute top-[15%] flex flex-col items-center">
        <img src="image-13.png" alt="Logo" class="mb-2 w-24" />
        <div class="font-poppins-bold text-5xl text-white">ESN</div>
      </div>
      <p
        class="font-poppins-regular absolute top-[60%] w-5/6 text-center text-base leading-relaxed text-white"
      >
        Your community's network for real-time alerts and help during
        emergencies.
      </p>
      <p
        class="font-poppins-regular absolute top-[70%] w-5/6 text-center text-base leading-relaxed text-white"
      >
        Let's help each other out.
      </p>
      <button
        class="font-poppins-semibold absolute top-[80%] h-12 w-5/6 bg-white text-lg text-[#d65841]"
      >
        Join Community
      </button>
    </div>
  </body>
</html>
