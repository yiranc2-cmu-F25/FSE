<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Join Community</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap");
      .font-poppins-bold {
        font-family: "Poppins", Helvetica;
        font-weight: 700;
      }
      .font-poppins-semibold {
        font-family: "Poppins", Helvetica;
        font-weight: 600;
      }
      .font-poppins-regular {
        font-family: "Poppins", Helvetica;
        font-weight: 400;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white">
    <div
      class="relative mx-auto flex h-screen w-full max-w-md flex-col items-center justify-center"
    >
      <div
        class="absolute top-[5%] flex w-11/12 items-center justify-start gap-1"
      >
        <img src="image-13.png" alt="Logo" class="w-20" />
        <div
          class="font-poppins-bold bg-[linear-gradient(0deg,rgba(37,48,77,1)_0%,rgba(86,112,179,1)_100%)] bg-clip-text text-center text-3xl text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]"
        >
          ESN
        </div>
      </div>
      <p
        class="font-poppins-semibold absolute top-[15%] text-center text-xl leading-normal text-black"
      >
        We're glad you are here
      </p>
      <p
        class="font-poppins-regular absolute top-[20%] text-center text-sm leading-normal text-gray-500"
      >
        Join ESN network to start helping community
      </p>
      <div
        class="absolute top-[30%] flex w-full items-center justify-center px-2"
      >
        <img src="vector.svg" alt="vector" class="h-44" />
      </div>
      <div
        class="absolute top-[55%] flex h-12 w-5/6 items-center rounded-full bg-white px-4 shadow-md"
      >
        <input
          type="text"
          placeholder="Enter Your User Name"
          class="font-poppins-regular w-full border-none text-sm text-gray-500 outline-none"
        />
      </div>
      <div
        class="absolute top-[65%] flex h-12 w-5/6 items-center rounded-full bg-white px-4 shadow-md"
      >
        <input
          type="password"
          placeholder="Enter Password"
          class="font-poppins-regular w-full border-none text-sm text-gray-500 outline-none"
        />
      </div>
      <button
        class="font-poppins-semibold absolute top-[75%] h-12 w-5/6 bg-[#d65841] text-lg text-white"
      >
        Join Community
      </button>
    </div>
  </body>
</html>
